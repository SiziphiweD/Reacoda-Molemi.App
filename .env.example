# Database Connection String
# Format: Host=YOUR_HOST;Database=YOUR_DATABASE;Username=YOUR_USERNAME;Password=YOUR_PASSWORD;Port=5432
ConnectionStrings__DefaultConnection=Host=localhost;Database=Reacoda_MolemiDB;Username=postgres;Password=YOUR_PASSWORD;Port=5432

# JWT Configuration
# IMPORTANT: Change the JWT Key to a secure random string (at least 32 characters)
Jwt__Key=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_AT_LEAST_32_CHARACTERS_LONG
Jwt__Issuer=ReacodeApp
Jwt__Audience=ReacodeAppUsers
Jwt__ExpiryMinutes=1440

# Stripe API Keys
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
Stripe__PublishableKey=YOUR_STRIPE_PUBLISHABLE_KEY
Stripe__SecretKey=YOUR_STRIPE_SECRET_KEY

# API Configuration
Api__BaseUrl=https://your-domain.com
Api__EnableSwaggerInProduction=true
