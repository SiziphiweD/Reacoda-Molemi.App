<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Reacoda Molemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/ReacodeApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-seedling me-2"></i>Reacoda Molemi
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                      <ul class="navbar-nav flex-grow-1">
                          <li class="nav-item">
                              <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                                  <i class="fas fa-home me-1"></i>Home
                              </a>
                          </li>
                          <li class="nav-item">
                              <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="About">
                                  <i class="fas fa-info-circle me-1"></i>About
                              </a>
                          </li>
                          <li class="nav-item">
                              <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Services">
                                  <i class="fas fa-cogs me-1"></i>Services
                              </a>
                          </li>
                          <li class="nav-item">
                              <a class="nav-link text-dark" asp-area="" asp-controller="Shop" asp-action="Index">
                                  <i class="fas fa-store me-1"></i>Shop
                              </a>
                          </li>
                          <li class="nav-item">
                              <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Contact">
                                  <i class="fas fa-envelope me-1"></i>Contact
                              </a>
                          </li>
                      </ul>
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("CurrentUser") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark position-relative" asp-controller="Buyer" asp-action="Cart">
                                    <i class="fas fa-shopping-cart me-1"></i>Cart
                                    <span class="cart-badge position-absolute top-0 start-100 translate-middle" style="display: none;">0</span>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user me-1"></i>Account
                                </a>
                                  <ul class="dropdown-menu">
                                      <li><a class="dropdown-item" asp-controller="Home" asp-action="Profile"><i class="fas fa-user me-2"></i>Profile</a></li>
                                      <li><a class="dropdown-item" asp-controller="Home" asp-action="Notifications"><i class="fas fa-bell me-2"></i>Notifications</a></li>
                                      
                                      @{
                                          var currentUserJson = Context.Session.GetString("CurrentUser");
                                          if (!string.IsNullOrEmpty(currentUserJson))
                                          {
                                              var currentUser = System.Text.Json.JsonSerializer.Deserialize<ReacodeApp.Models.User>(currentUserJson);
                                              if (currentUser?.Role == ReacodeApp.Models.UserRole.SuperAdmin)
                                              {
                                                  <li><hr class="dropdown-divider"></li>
                                                  <li><h6 class="dropdown-header text-warning"><i class="fas fa-crown me-2"></i>Super Admin Panel</h6></li>
                                                  <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="Dashboard"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</a></li>
                                                  <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="AdminManagement"><i class="fas fa-users-cog me-2"></i>Admin Management</a></li>
                                                  <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="SystemConfiguration"><i class="fas fa-cogs me-2"></i>System Configuration</a></li>
                                                  <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="AuditLogs"><i class="fas fa-clipboard-list me-2"></i>Audit Logs</a></li>
                                                  <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="GlobalAnalytics"><i class="fas fa-chart-line me-2"></i>Global Analytics</a></li>
                                                  <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="RevenueManagement"><i class="fas fa-chart-pie me-2"></i>Revenue Management</a></li>
                                                  <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="PlatformSettings"><i class="fas fa-palette me-2"></i>Platform Settings</a></li>
                                                  <li><a class="dropdown-item" asp-controller="SuperAdmin" asp-action="Profile"><i class="fas fa-crown me-2"></i>Super Admin Profile</a></li>
                                              }
                                              else if (currentUser?.Role == ReacodeApp.Models.UserRole.Admin)
                                              {
                                                  <li><hr class="dropdown-divider"></li>
                                                  <li><h6 class="dropdown-header text-success"><i class="fas fa-shield-alt me-2"></i>Admin Panel</h6></li>
                                                  <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</a></li>
                                                  <li><a class="dropdown-item" asp-controller="Admin" asp-action="UserManagement"><i class="fas fa-users me-2"></i>User Management</a></li>
                                                  <li><a class="dropdown-item" asp-controller="Admin" asp-action="ProductVerification"><i class="fas fa-check-circle me-2"></i>Product Verification</a></li>
                                                  <li><a class="dropdown-item" asp-controller="Admin" asp-action="OrdersManagement"><i class="fas fa-shopping-cart me-2"></i>Orders Management</a></li>
                                                  <li><a class="dropdown-item" asp-controller="Admin" asp-action="Reports"><i class="fas fa-chart-bar me-2"></i>Reports</a></li>
                                                  <li><a class="dropdown-item" asp-controller="Admin" asp-action="Messages"><i class="fas fa-comments me-2"></i>Messages</a></li>
                                                  <li><a class="dropdown-item" asp-controller="Admin" asp-action="ProfileSettings"><i class="fas fa-user-cog me-2"></i>Profile Settings</a></li>
                                                  <li><a class="dropdown-item" asp-controller="Admin" asp-action="Announcements"><i class="fas fa-bullhorn me-2"></i>Announcements</a></li>
                                              }
                                              else if (currentUser?.Role == ReacodeApp.Models.UserRole.Farmer)
                                              {
                                                  <li><hr class="dropdown-divider"></li>
                                                  <li><h6 class="dropdown-header text-success"><i class="fas fa-seedling me-2"></i>Farmer Panel</h6></li>
                                                  <li><a class="dropdown-item" asp-controller="Farmer" asp-action="Dashboard"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</a></li>
                                                  <li><a class="dropdown-item" asp-controller="Farmer" asp-action="MyProducts"><i class="fas fa-box me-2"></i>My Products</a></li>
                                                  <li><a class="dropdown-item" asp-controller="Farmer" asp-action="OrdersReceived"><i class="fas fa-shopping-cart me-2"></i>Orders</a></li>
                                                  <li><a class="dropdown-item" asp-controller="Farmer" asp-action="Earnings"><i class="fas fa-dollar-sign me-2"></i>Earnings</a></li>
                                              }
                                              else if (currentUser?.Role == ReacodeApp.Models.UserRole.Buyer)
                                              {
                                                  <li><hr class="dropdown-divider"></li>
                                                  <li><h6 class="dropdown-header text-info"><i class="fas fa-shopping-bag me-2"></i>Buyer Panel</h6></li>
                                                  <li><a class="dropdown-item" asp-controller="Buyer" asp-action="Dashboard"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</a></li>
                                                  <li><a class="dropdown-item" asp-controller="Buyer" asp-action="Shop"><i class="fas fa-store me-2"></i>Shop</a></li>
                                                  <li><a class="dropdown-item" asp-controller="Buyer" asp-action="Cart"><i class="fas fa-shopping-cart me-2"></i>Cart</a></li>
                                                  <li><a class="dropdown-item" asp-controller="Buyer" asp-action="OrdersHistory"><i class="fas fa-history me-2"></i>Order History</a></li>
                                                  <li><a class="dropdown-item" asp-controller="Buyer" asp-action="Favorites"><i class="fas fa-heart me-2"></i>Favorites</a></li>
                                              }
                                          }
                                      }
                                      
                                      <li><hr class="dropdown-divider"></li>
                                      <li>
                                          <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                              <button type="submit" class="dropdown-item">
                                                  <i class="fas fa-sign-out-alt me-2"></i>Logout
                                              </button>
                                          </form>
                                      </li>
                                  </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Auth" asp-action="Login">
                                    <i class="fas fa-sign-in-alt me-1"></i>Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-success ms-2" asp-controller="Auth" asp-action="Register">
                                    <i class="fas fa-user-plus me-1"></i>Sign Up
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5 class="fw-bold mb-3">
                        <i class="fas fa-seedling me-2"></i>Reacoda Molemi
                    </h5>
                    <p class="mb-3">Connecting farmers and buyers for fresh, local produce. Supporting sustainable agriculture and local communities.</p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-white"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
                <div class="col-md-2">
                    <h6 class="fw-bold mb-3">Quick Links</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-white-50 text-decoration-none">About Us</a></li>
                        <li><a href="#" class="text-white-50 text-decoration-none">How It Works</a></li>
                        <li><a href="#" class="text-white-50 text-decoration-none">For Farmers</a></li>
                        <li><a href="#" class="text-white-50 text-decoration-none">For Buyers</a></li>
                    </ul>
                </div>
                <div class="col-md-2">
                    <h6 class="fw-bold mb-3">Support</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-white-50 text-decoration-none">Help Center</a></li>
                        <li><a href="#" class="text-white-50 text-decoration-none">Contact Us</a></li>
                        <li><a href="#" class="text-white-50 text-decoration-none">FAQ</a></li>
                        <li><a href="#" class="text-white-50 text-decoration-none">Terms of Service</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold mb-3">Contact Info</h6>
                    <p class="mb-2"><i class="fas fa-envelope me-2"></i>support@reacoda.com</p>
                    <p class="mb-2"><i class="fas fa-phone me-2"></i>+27 11 123 4567</p>
                    <p class="mb-0"><i class="fas fa-map-marker-alt me-2"></i>Johannesburg, South Africa</p>
                </div>
            </div>
            <div class="footer-bottom">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <p class="mb-0">&copy; 2024 Reacoda Molemi. All rights reserved.</p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <a asp-area="" asp-controller="Home" asp-action="Privacy" class="me-3">Privacy Policy</a>
                        <a href="#">Terms of Service</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/enhanced.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
