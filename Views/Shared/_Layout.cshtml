@inject ReacodeApp.Services.ISessionService SessionService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Reacoda Molemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/ReacodeApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-proper">
            <div class="container">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                    <img src="~/images/reacoda_logo.png" alt="Reacoda Molemi" class="navbar-logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    @{
                        var currentUser = SessionService.GetUser();
                        var userRole = currentUser?.Role;
                    }
                    @if (currentUser == null)
                    {
                        <!-- Guest Navigation -->
                        <ul class="navbar-nav navbar-nav-center">
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "Home")">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("About", "Home")">About</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "Shop")">Shop</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Services", "Home")">Services</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Contact", "Home")">Contact</a>
                            </li>
                        </ul>
                    }
                    else if (userRole == ReacodeApp.Models.UserRole.Buyer)
                    {
                        <!-- Buyer Navigation -->
                        <ul class="navbar-nav navbar-nav-center">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Buyer" asp-action="Dashboard">
                                    <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Buyer" asp-action="Shop">
                                    <i class="fas fa-store me-1"></i>Shop
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link position-relative" asp-controller="Buyer" asp-action="Cart">
                                    <i class="fas fa-shopping-cart me-1"></i>Cart
                                    <span class="cart-badge position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">0</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Buyer" asp-action="OrdersHistory">
                                    <i class="fas fa-history me-1"></i>Order History
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Buyer" asp-action="Favorites">
                                    <i class="fas fa-heart me-1"></i>Favorites
                                </a>
                            </li>
                        </ul>
                    }
                    else if (userRole == ReacodeApp.Models.UserRole.Farmer)
                    {
                        <!-- Farmer Navigation -->
                        <ul class="navbar-nav navbar-nav-center">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Farmer" asp-action="Dashboard">
                                    <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Farmer" asp-action="MyProducts">
                                    <i class="fas fa-box me-1"></i>My Products
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Farmer" asp-action="OrdersReceived">
                                    <i class="fas fa-shopping-bag me-1"></i>Orders
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Farmer" asp-action="Earnings">
                                    <i class="fas fa-dollar-sign me-1"></i>Earnings
                                </a>
                            </li>
                        </ul>
                    }
                    else if (userRole == ReacodeApp.Models.UserRole.Admin)
                    {
                        <!-- Admin Navigation -->
                        <ul class="navbar-nav navbar-nav-center">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="UserManagement">
                                    <i class="fas fa-users me-1"></i>Users
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="ProductVerification">
                                    <i class="fas fa-check-circle me-1"></i>Products
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="OrdersManagement">
                                    <i class="fas fa-shopping-cart me-1"></i>Orders
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Reports">
                                    <i class="fas fa-chart-bar me-1"></i>Reports
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Messages">
                                    <i class="fas fa-envelope me-1"></i>Messages
                                </a>
                            </li>
                        </ul>
                    }
                    else if (userRole == ReacodeApp.Models.UserRole.SuperAdmin)
                    {
                        <!-- SuperAdmin Navigation -->
                        <ul class="navbar-nav navbar-nav-center">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="SuperAdmin" asp-action="Dashboard">
                                    <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="UserManagement">
                                    <i class="fas fa-users me-1"></i>Users
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="SuperAdmin" asp-action="AdminManagement">
                                    <i class="fas fa-user-shield me-1"></i>Admins
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="ProductVerification">
                                    <i class="fas fa-check-circle me-1"></i>Products
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="OrdersManagement">
                                    <i class="fas fa-shopping-cart me-1"></i>Orders
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Reports">
                                    <i class="fas fa-chart-bar me-1"></i>Reports
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Messages">
                                    <i class="fas fa-envelope me-1"></i>Messages
                                </a>
                            </li>
                        </ul>
                    }
                    <ul class="navbar-nav navbar-nav-right">
                        @if (currentUser != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Profile", "Home")">
                                    <i class="fas fa-user me-1"></i>Profile
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link position-relative" href="@Url.Action("Notifications", "Home")">
                                    <i class="fas fa-bell me-1"></i>Notifications
                                    <span id="notification-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none; font-size: 0.7rem; min-width: 18px; height: 18px; padding: 2px 6px; line-height: 14px;">0</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <form action="@Url.Action("Logout", "Auth")" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="nav-link btn btn-link border-0 p-0" style="background: none; color: inherit; cursor: pointer; text-decoration: none;">
                                        <i class="fas fa-sign-out-alt me-1"></i>Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Login", "Auth")">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary-nav ms-2" href="@Url.Action("Register", "Auth")">Sign Up</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-modern">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section footer-about">
                    <div class="footer-logo">
                        <h5 class="footer-brand">
                            <i class="fas fa-seedling me-2"></i>Reacoda Molemi
                        </h5>
                    </div>
                    <p class="footer-description">Connecting farmers and buyers for fresh, local produce. Supporting sustainable agriculture and local communities.</p>
                    <div class="footer-social">
                        <a href="#" class="social-link" aria-label="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#" class="social-link" aria-label="Twitter">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="#" class="social-link" aria-label="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="#" class="social-link" aria-label="LinkedIn">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                    </div>
                </div>
                
                <div class="footer-section footer-links">
                    <h6 class="footer-heading">Quick Links</h6>
                    <ul class="footer-list">
                        <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                        <li><a href="#how-it-works">How It Works</a></li>
                        <li><a href="@Url.Action("Register", "Auth", new { role = "Farmer" })">For Farmers</a></li>
                        <li><a href="@Url.Action("Index", "Shop")">For Buyers</a></li>
                    </ul>
                </div>
                
                <div class="footer-section footer-links">
                    <h6 class="footer-heading">Support</h6>
                    <ul class="footer-list">
                        <li><a href="#">Help Center</a></li>
                        <li><a href="#">Contact Us</a></li>
                        <li><a href="#">FAQ</a></li>
                        <li><a href="@Url.Action("Privacy", "Home")">Privacy Policy</a></li>
                    </ul>
                </div>
                
                <div class="footer-section footer-contact">
                    <h6 class="footer-heading">Contact Info</h6>
                    <ul class="footer-contact-list">
                        <li>
                            <i class="fas fa-envelope"></i>
                            <span>support@reacoda.com</span>
                        </li>
                        <li>
                            <i class="fas fa-phone"></i>
                            <span>+27 11 123 4567</span>
                        </li>
                        <li>
                            <i class="fas fa-map-marker-alt"></i>
                            <span>Tshimologong Precinct, Braamfontein, Johannesburg</span>
                        </li>
                    </ul>
                </div>
            </div>
            
            <div class="footer-bottom">
                <div class="footer-bottom-content">
                    <p class="copyright">&copy; 2024 Reacoda Molemi. All rights reserved.</p>
                    <div class="footer-legal">
                        <a href="@Url.Action("Privacy", "Home")">Privacy Policy</a>
                        <span class="separator">|</span>
                        <a href="#">Terms of Service</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/enhanced.js" asp-append-version="true"></script>
    
    @if (currentUser != null)
    {
        <script>

            // Real-time new notification count update (shows new messages sent, not just unread)
            function updateNotificationCount() {
                fetch('@Url.Action("GetUnreadNotificationCount", "Home")')
                    .then(response => response.json())
                    .then(data => {
                        const badge = document.getElementById('notification-badge');
                        if (badge) {
                            const count = data.count || 0;
                            badge.textContent = count;
                            if (count > 0) {
                                badge.style.display = 'inline-block';
                            } else {
                                badge.style.display = 'none';
                            }
                        }
                    })
                    .catch(error => {
                        console.error('Error fetching notification count:', error);
                    });
            }

            // Mark notifications as viewed when clicking on the notification link
            document.addEventListener('DOMContentLoaded', function() {
                const notificationLink = document.querySelector('a[href*="/Home/Notifications"]');
                if (notificationLink) {
                    notificationLink.addEventListener('click', function() {
                        // Mark notifications as viewed when user clicks the link
                        fetch('@Url.Action("MarkNotificationsAsViewed", "Home")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            }
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                // Update badge immediately
                                updateNotificationCount();
                            }
                        })
                        .catch(error => {
                            console.error('Error marking notifications as viewed:', error);
                        });
                    });
                }

                // Update notification count on page load
                updateNotificationCount();
                
                // Update notification count every 15 seconds for real-time updates
                setInterval(updateNotificationCount, 15000);
            });
        </script>
    }
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
