@model Order
@{
    ViewData["Title"] = "Confirm Delivery";
    var hasRated = ViewBag.HasRated as bool? ?? false;
    var existingRating = ViewBag.ExistingRating as FarmerRating;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-check-circle me-2"></i>Confirm Delivery - Order #@Model.OrderNumber
                    </h5>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Farmer has arrived!</strong> Please confirm that you have received your order and rate your experience.
                    </div>

                    <!-- Order Summary -->
                    <div class="mb-4">
                        <h6 class="fw-bold mb-3">Order Summary</h6>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <strong>Farmer:</strong> @(Model.Farmer != null ? $"{Model.Farmer.FirstName} {Model.Farmer.LastName}" : "N/A")
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Total Amount:</strong> R @Model.TotalAmount.ToString("N2")
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Order Date:</strong> @Model.CreatedAt.ToString("MMMM dd, yyyy HH:mm")
                            </div>
                            @if (Model.ArrivedDate.HasValue)
                            {
                                <div class="col-md-6 mb-2">
                                    <strong>Arrived At:</strong> @Model.ArrivedDate.Value.ToString("MMMM dd, yyyy HH:mm")
                                </div>
                            }
                        </div>
                        <div class="mt-3">
                            <strong>Items:</strong>
                            <ul class="list-unstyled mt-2">
                                @if (Model.OrderItems != null && Model.OrderItems.Any())
                                {
                                    @foreach (var item in Model.OrderItems)
                                    {
                                        <li>
                                            <i class="fas fa-check text-success me-2"></i>
                                            @(item.Product != null ? item.Product.Name : "Product") - @item.Quantity kg × R @item.UnitPrice.ToString("N2")
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    </div>

                    <hr>

                    <!-- Delivery Confirmation Form -->
                    <form asp-action="ConfirmDelivery" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                <i class="fas fa-star me-2 text-warning"></i>Rate Your Experience <span class="text-danger">*</span>
                            </label>
                            <div class="rating-input mb-3">
                                @for (int i = 5; i >= 1; i--)
                                {
                                    <input type="radio" name="rating" id="rating@i" value="@i" class="d-none" required @(hasRated && existingRating?.Rating == i ? "checked" : "") />
                                    <label for="rating@i" class="rating-star" data-rating="@i">
                                        <i class="fas fa-star @(hasRated && existingRating != null && existingRating.Rating >= i ? "text-warning" : "text-muted")"></i>
                                    </label>
                                }
                            </div>
                            <small class="text-muted">Click on the stars to rate (1 = Poor, 5 = Excellent)</small>
                        </div>

                        <div class="mb-4">
                            <label for="comment" class="form-label fw-bold">
                                <i class="fas fa-comment-alt me-2"></i>Comments (Optional)
                            </label>
                            <textarea id="comment" name="comment" class="form-control" rows="4" 
                                      placeholder="Share your experience with this delivery...">@(hasRated ? existingRating?.Comment : "")</textarea>
                            <small class="text-muted">Tell us about your delivery experience</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-check-circle me-2"></i>Confirm Delivery & Submit Rating
                            </button>
                            <a asp-action="OrdersHistory" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ratingStars = document.querySelectorAll('.rating-star');
            const ratingInputs = document.querySelectorAll('input[name="rating"]');
            
            ratingStars.forEach(star => {
                star.addEventListener('click', function() {
                    const rating = parseInt(this.getAttribute('data-rating'));
                    updateStars(rating);
                });
                
                star.addEventListener('mouseenter', function() {
                    const rating = parseInt(this.getAttribute('data-rating'));
                    highlightStars(rating);
                });
            });
            
            document.querySelector('.rating-input').addEventListener('mouseleave', function() {
                const checkedInput = document.querySelector('input[name="rating"]:checked');
                if (checkedInput) {
                    const rating = parseInt(checkedInput.value);
                    highlightStars(rating);
                } else {
                    highlightStars(0);
                }
            });
            
            function updateStars(rating) {
                ratingInputs.forEach(input => {
                    if (parseInt(input.value) === rating) {
                        input.checked = true;
                    }
                });
                highlightStars(rating);
            }
            
            function highlightStars(rating) {
                ratingStars.forEach(star => {
                    const starRating = parseInt(star.getAttribute('data-rating'));
                    const icon = star.querySelector('i');
                    if (starRating <= rating) {
                        icon.classList.remove('text-muted');
                        icon.classList.add('text-warning');
                    } else {
                        icon.classList.remove('text-warning');
                        icon.classList.add('text-muted');
                    }
                });
            }
        });
    </script>
    <style>
        .rating-input {
            display: flex;
            flex-direction: row-reverse;
            justify-content: flex-end;
            gap: 0.5rem;
        }
        .rating-star {
            cursor: pointer;
            font-size: 2rem;
            transition: transform 0.2s;
        }
        .rating-star:hover {
            transform: scale(1.2);
        }
        .rating-star i {
            transition: color 0.2s;
        }
    </style>
}





