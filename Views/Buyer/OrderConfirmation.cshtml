@model Order
@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Success Header -->
            <div class="text-center mb-5">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                <div class="success-icon mb-4">
                    <i class="fas fa-check-circle fa-5x text-success"></i>
                </div>
                <h1 class="text-success fw-bold">Order Placed Successfully!</h1>
                <p class="text-muted fs-5">
                    @if (Model.Status == OrderStatus.Pending)
                    {
                        <text>Your order is pending farmer approval. You'll be notified once the farmer accepts or rejects your order.</text>
                    }
                    else
                    {
                        <text>Thank you for your order. We'll notify you when it's ready for delivery.</text>
                    }
                </p>
            </div>

            <!-- Order Details Card -->
            <div class="card shadow mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-receipt me-2"></i>Order Details
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Order Number:</strong>
                                <div class="text-primary fs-5">#@Model.OrderNumber</div>
                            </div>
                            <div class="mb-3">
                                <strong>Order Date:</strong>
                                <div>@Model.CreatedAt.ToString("MMMM dd, yyyy 'at' HH:mm")</div>
                            </div>
                            <div class="mb-3">
                                <strong>Status:</strong>
                                <span class="badge bg-warning fs-6">@Model.Status</span>
                                @if (Model.Status == OrderStatus.Pending && Model.ResponseDeadline.HasValue)
                                {
                                    <div class="small text-muted mt-1">
                                        <i class="fas fa-clock me-1"></i>Farmer has until @Model.ResponseDeadline.Value.ToString("HH:mm") UTC to respond
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Farmer:</strong>
                                <div>@(Model.Farmer != null ? $"{Model.Farmer.FirstName} {Model.Farmer.LastName}" : "N/A")</div>
                            </div>
                            <div class="mb-3">
                                <strong>Total Amount:</strong>
                                <div class="text-success fs-5 fw-bold">R @Model.TotalAmount.ToString("N2")</div>
                            </div>
                            <div class="mb-3">
                                <strong>Payment Method:</strong>
                                <div>@Model.PaymentMethod</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delivery Information -->
            <div class="card shadow mb-4">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-truck me-2"></i>Delivery Information
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Delivery Address:</strong>
                                <div>@Model.DeliveryAddress</div>
                            </div>
                            <div class="mb-3">
                                <strong>City:</strong>
                                <div>@Model.DeliveryCity</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Province:</strong>
                                <div>@Model.DeliveryProvince</div>
                            </div>
                            <div class="mb-3">
                                <strong>Postal Code:</strong>
                                <div>@Model.DeliveryPostalCode</div>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.DeliveryNotes))
                    {
                        <div class="mb-3">
                            <strong>Delivery Notes:</strong>
                            <div class="text-muted">@Model.DeliveryNotes</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Order Items -->
            <div class="card shadow mb-4">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-info">
                        <i class="fas fa-boxes me-2"></i>Order Items (@(Model.OrderItems?.Count ?? 0))
                    </h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                    <th>Price per kg</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OrderItems != null && Model.OrderItems.Any())
                                {
                                    @foreach (var item in Model.OrderItems)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (item.Product != null)
                                                    {
                                                        @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                                        {
                                                            <img src="@item.Product.ImageUrl" alt="@item.Product.Name" 
                                                                 class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;"
                                                                 onerror="this.src='/images/default-product.jpg'; this.onerror=null;">
                                                        }
                                                        else
                                                        {
                                                            <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                                <i class="fas fa-image text-muted"></i>
                                                            </div>
                                                        }
                                                        <div>
                                                            <div class="fw-bold">@item.Product.Name</div>
                                                            <small class="text-muted">@(item.Product.Category?.Name ?? "N/A")</small>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div>
                                                            <div class="fw-bold text-muted">Product Not Found</div>
                                                            <small class="text-muted">Product ID: @item.ProductId</small>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary">@item.Quantity kg</span>
                                            </td>
                                            <td>R @item.UnitPrice.ToString("N2")</td>
                                            <td class="fw-bold">R @item.TotalPrice.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">No items found in this order.</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light">
                                    <th colspan="3">Total Amount:</th>
                                    <th class="text-success">R @Model.TotalAmount.ToString("N2")</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Next Steps -->
            <div class="card shadow mb-4">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-warning">
                        <i class="fas fa-info-circle me-2"></i>What Happens Next?
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 text-center mb-3">
                            <div class="step-icon mb-3">
                                <i class="fas fa-clock fa-2x text-warning"></i>
                            </div>
                            <h6>Order Confirmation</h6>
                            <p class="text-muted small">Your order is being processed by the farmer</p>
                        </div>
                        <div class="col-md-4 text-center mb-3">
                            <div class="step-icon mb-3">
                                <i class="fas fa-truck fa-2x text-primary"></i>
                            </div>
                            <h6>Preparation & Shipping</h6>
                            <p class="text-muted small">Fresh produce will be prepared and shipped</p>
                        </div>
                        <div class="col-md-4 text-center mb-3">
                            <div class="step-icon mb-3">
                                <i class="fas fa-home fa-2x text-success"></i>
                            </div>
                            <h6>Delivery</h6>
                            <p class="text-muted small">Your order will be delivered to your address</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="text-center mb-4">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <a asp-action="OrderTracking" asp-route-id="@Model.Id" class="btn btn-primary w-100">
                            <i class="fas fa-search me-2"></i>Track Order
                        </a>
                    </div>
                    <div class="col-md-4 mb-3">
                        <a asp-action="OrdersHistory" class="btn btn-outline-primary w-100">
                            <i class="fas fa-history me-2"></i>Order History
                        </a>
                    </div>
                    <div class="col-md-4 mb-3">
                        <a asp-controller="Shop" asp-action="Index" class="btn btn-success w-100">
                            <i class="fas fa-store me-2"></i>Continue Shopping
                        </a>
                    </div>
                </div>
            </div>

            <!-- Contact Information -->
            <div class="card shadow">
                <div class="card-header">
                    <h6 class="m-0 font-weight-bold text-info">
                        <i class="fas fa-headset me-2"></i>Need Help?
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Contact Farmer</h6>
                            @if (Model.Farmer != null)
                            {
                                <p class="text-muted mb-2">@Model.Farmer.FirstName @Model.Farmer.LastName</p>
                                <p class="text-muted mb-2">
                                    <i class="fas fa-envelope me-2"></i>@Model.Farmer.Email
                                </p>
                                @if (!string.IsNullOrEmpty(Model.Farmer.PhoneNumber))
                                {
                                    <p class="text-muted mb-0">
                                        <i class="fas fa-phone me-2"></i>@Model.Farmer.PhoneNumber
                                    </p>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-2">Farmer information not available</p>
                            }
                        </div>
                        <div class="col-md-6">
                            <h6>Customer Support</h6>
                            <p class="text-muted mb-2">Reacoda Molemi Support Team</p>
                            <p class="text-muted mb-2">
                                <i class="fas fa-envelope me-2"></i>support@reacoda.com
                            </p>
                            <p class="text-muted mb-0">
                                <i class="fas fa-phone me-2"></i>+27 11 123 4567
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .success-icon {
        animation: bounceIn 0.6s ease-in-out;
    }
    
    @@keyframes bounceIn {
        0% {
            transform: scale(0.3);
            opacity: 0;
        }
        50% {
            transform: scale(1.05);
        }
        70% {
            transform: scale(0.9);
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
    
    .step-icon {
        transition: transform 0.2s ease-in-out;
    }
    
    .step-icon:hover {
        transform: scale(1.1);
    }
</style>
