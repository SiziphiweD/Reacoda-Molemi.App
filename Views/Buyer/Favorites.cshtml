@model List<ReacodeApp.Models.Favorite>
@{
    ViewData["Title"] = "My Favorites";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">
                    <i class="fas fa-heart text-danger me-2"></i>My Favorites
                </h2>
                <div class="d-flex gap-2">
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-success">
                        <i class="fas fa-store me-1"></i>Continue Shopping
                    </a>
                </div>
            </div>

            @if (Model.Any())
            {
                <div class="row">
                    @foreach (var favorite in Model)
                    {
                        var product = favorite.Product;
                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 mb-4">
                            <div class="card h-100 shadow-sm product-card">
                                <div class="position-relative">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 150px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 150px;">
                                            <i class="fas fa-image text-muted fa-3x"></i>
                                        </div>
                                    }
                                    <div class="position-absolute top-0 end-0 p-2">
                                        <button class="btn btn-sm btn-danger rounded-circle" onclick="removeFromFavorites(@product.Id)" title="Remove from favorites">
                                            <i class="fas fa-heart"></i>
                                        </button>
                                    </div>
                                    @if (!product.IsAvailable)
                                    {
                                        <div class="position-absolute top-0 start-0 p-2">
                                            <span class="badge bg-warning">Out of Stock</span>
                                        </div>
                                    }
                                </div>
                                
                                <div class="card-body d-flex flex-column p-2">
                                    <h6 class="card-title mb-1" style="font-size: 0.9rem;">@product.Name</h6>
                                    <p class="card-text text-muted mb-2" style="font-size: 0.75rem;">@product.Category?.Name</p>
                                    <p class="card-text flex-grow-1 mb-2" style="font-size: 0.7rem; line-height: 1.2;">@(product.Description.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description)</p>
                                    
                                    <div class="mt-auto">
                                        <div class="mb-2">
                                            <small class="text-muted d-block">Price:</small>
                                            <div class="fw-bold text-success" style="font-size: 0.9rem;">R @product.PricePerKg.ToString("F2")/kg</div>
                                        </div>
                                        <div class="mb-2">
                                            <small class="text-muted d-block">Available:</small>
                                            <div class="fw-bold" style="font-size: 0.8rem;">@product.AvailableQuantity kg</div>
                                        </div>
                                        
                                        <div class="d-grid gap-1">
                                            <a href="@Url.Action("ProductDetails", "Buyer", new { id = product.Id })" class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-eye me-1"></i>View
                                            </a>
                        @if (product.IsAvailable && product.AvailableQuantity > 0)
                        {
                            <button class="btn btn-success btn-sm" onclick="addToCart(@product.Id)">
                                <i class="fas fa-cart-plus me-1"></i>Add to Cart
                            </button>
                        }
                                            else
                                            {
                                                <button class="btn btn-secondary btn-sm" disabled>
                                                    <i class="fas fa-times me-1"></i>Out of Stock
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="card-footer bg-transparent p-2">
                                    <small class="text-muted" style="font-size: 0.7rem;">
                                        <i class="fas fa-clock me-1"></i>Added @favorite.CreatedAt.ToString("MMM dd")
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-4">
                        <i class="fas fa-heart text-muted" style="font-size: 4rem;"></i>
                    </div>
                    <h4 class="text-muted mb-3">No Favorites Yet</h4>
                    <p class="text-muted mb-4">Start exploring our fresh produce and add items to your favorites!</p>
                    <a href="@Url.Action("Shop", "Buyer")" class="btn btn-success btn-lg">
                        <i class="fas fa-shopping-cart me-2"></i>Start Shopping
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Buy Now function removed - using Add to Cart only

    function addToCart(productId) {
        const formData = new FormData();
        formData.append('productId', productId);
        formData.append('quantity', 1);
        
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';
        const headers = {};
        if (token) {
            headers['RequestVerificationToken'] = token;
            formData.append('__RequestVerificationToken', token);
        }

        fetch('@Url.Action("AddToCart", "Buyer")', {
            method: 'POST',
            headers: headers,
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showToast('Added to cart!', 'success');
                updateCartCount();
            } else {
                showToast(data.message || 'Failed to add to cart', 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showToast('An error occurred', 'error');
        });
    }

    function removeFromFavorites(productId) {
        if (confirm('Remove this item from your favorites?')) {
            fetch('@Url.Action("RemoveFromFavorites", "Buyer")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({ productId: productId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast('Removed from favorites', 'success');
                    location.reload(); // Refresh to update the view
                } else {
                    showToast(data.message || 'Failed to remove from favorites', 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showToast('An error occurred', 'error');
            });
        }
    }

    function showToast(message, type) {
        // Simple toast notification
        const toast = document.createElement('div');
        toast.className = `alert alert-${type === 'success' ? 'success' : 'danger'} position-fixed`;
        toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        toast.innerHTML = `
            <i class="fas fa-${type === 'success' ? 'check' : 'exclamation-triangle'} me-2"></i>
            ${message}
        `;
        document.body.appendChild(toast);
        
        setTimeout(() => {
            toast.remove();
        }, 3000);
    }

    function updateCartCount() {
        // Update cart count in header if exists
        fetch('@Url.Action("GetCartCount", "Buyer")')
            .then(response => response.json())
            .then(data => {
                const cartBadge = document.querySelector('.cart-count');
                if (cartBadge) {
                    cartBadge.textContent = data.count;
                }
            });
    }
</script>

<style>
    .product-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        border: none;
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
    }

    .card-img-top {
        border-radius: 8px 8px 0 0;
    }

    .btn-sm {
        padding: 0.375rem 0.75rem;
    }

    .position-absolute .btn {
        opacity: 0.8;
        transition: opacity 0.2s ease;
    }

    .position-absolute .btn:hover {
        opacity: 1;
    }
</style>
