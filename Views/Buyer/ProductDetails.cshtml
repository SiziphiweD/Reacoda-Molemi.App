@model ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Product.Name;
}

@Html.AntiForgeryToken()

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Shop">Shop</a></li>
                    <li class="breadcrumb-item"><a asp-action="Shop" asp-route-categoryId="@Model.Product.CategoryId">@Model.Product.Category.Name</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Product.Name</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <!-- Product Images -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-body p-0">
                    <div class="position-relative">
                        <img src="@Model.Product.ImageUrl" class="img-fluid w-100" alt="@Model.Product.Name" style="height: 400px; object-fit: cover;">
                        <div class="position-absolute top-0 end-0 m-3">
                            @if (Model.Product.IsAvailable)
                            {
                                <span class="badge bg-success fs-6">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6">Out of Stock</span>
                            }
                        </div>
                        <div class="position-absolute top-0 start-0 m-3">
                            <button class="btn btn-sm btn-outline-danger favorite-btn" data-product-id="@Model.Product.Id">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Information -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h1 class="card-title text-success mb-3">@Model.Product.Name</h1>
                    
                    <!-- Rating -->
                    <div class="mb-3">
                        <div class="d-flex align-items-center">
                            <div class="rating me-3">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(Model.AverageRating))
                                    {
                                        <i class="fas fa-star text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star text-muted"></i>
                                    }
                                }
                            </div>
                            <span class="text-muted">@Model.AverageRating.ToString("F1") (@Model.ReviewCount reviews)</span>
                        </div>
                    </div>

                    <!-- Price -->
                    <div class="mb-4">
                        <h2 class="text-success fw-bold">R @Model.Product.PricePerKg.ToString("N2") <small class="text-muted">per kg</small></h2>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <h5>Description</h5>
                        <p class="text-muted">@Model.Product.Description</p>
                    </div>

                    <!-- Product Details -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Category:</strong>
                                <span class="text-muted">@Model.Product.Category.Name</span>
                            </div>
                            <div class="mb-3">
                                <strong>Available Quantity:</strong>
                                <span class="text-muted">@Model.Product.AvailableQuantity kg</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <strong>Location:</strong>
                                <span class="text-muted">@Model.Product.Location</span>
                            </div>
                            @if (Model.Product.HarvestDate.HasValue)
                            {
                                <div class="mb-3">
                                    <strong>Harvested:</strong>
                                    <span class="text-muted">@Model.Product.HarvestDate.Value.ToString("MMM dd, yyyy")</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Farmer Information -->
                    <div class="card bg-light mb-4">
                        <div class="card-body">
                            <h6 class="card-title">
                                <i class="fas fa-user me-2"></i>Farmer Information
                            </h6>
                            <div class="d-flex align-items-center">
                                <div class="avatar-sm bg-primary rounded-circle d-flex align-items-center justify-content-center me-3">
                                    <i class="fas fa-user text-white"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">@Model.Product.Farmer.FirstName @Model.Product.Farmer.LastName</div>
                                    <div class="text-muted small">@Model.Product.Farmer.Email</div>
                                    @if (!string.IsNullOrEmpty(Model.Product.Farmer.PhoneNumber))
                                    {
                                        <div class="text-muted small">
                                            <i class="fas fa-phone me-1"></i>@Model.Product.Farmer.PhoneNumber
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Add to Cart -->
                    @if (Model.Product.IsAvailable)
                    {
                        <div class="card bg-success text-white">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="fas fa-shopping-cart me-2"></i>Add to Cart
                                </h6>
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <label class="form-label text-white">Quantity (kg):</label>
                                        <div class="input-group">
                                            <button class="btn btn-outline-light" type="button" onclick="decreaseQuantity()">-</button>
                                            <input type="number" id="quantity" class="form-control text-center" value="1" min="1" max="@Model.Product.AvailableQuantity">
                                            <button class="btn btn-outline-light" type="button" onclick="increaseQuantity()">+</button>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="text-center">
                                            <div class="h5 mb-2">Total: R <span id="totalPrice">@Model.Product.PricePerKg.ToString("N2")</span></div>
                                            <button class="btn btn-light btn-lg w-100 add-to-cart" data-product-id="@Model.Product.Id">
                                                <i class="fas fa-cart-plus me-2"></i>Add to Cart
                                            </button>
                                            <button class="btn btn-primary btn-lg w-100 mt-2 buy-now" data-product-id="@Model.Product.Id">
                                                <i class="fas fa-bolt me-2"></i>Buy Now
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Out of Stock:</strong> This product is currently unavailable.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Product Reviews -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-star me-2"></i>Customer Reviews (@Model.ReviewCount)
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Product.Reviews.Any())
                    {
                        @foreach (var review in Model.Product.Reviews.OrderByDescending(r => r.CreatedAt))
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="d-flex align-items-start">
                                    <div class="avatar-sm bg-primary rounded-circle d-flex align-items-center justify-content-center me-3">
                                        <i class="fas fa-user text-white"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center mb-2">
                                            <h6 class="mb-0 me-3">@review.Buyer.FirstName @review.Buyer.LastName</h6>
                                            <div class="rating">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= review.Rating)
                                                    {
                                                        <i class="fas fa-star text-warning"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="far fa-star text-muted"></i>
                                                    }
                                                }
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(review.Comment))
                                        {
                                            <p class="mb-2">@review.Comment</p>
                                        }
                                        <small class="text-muted">
                                            <i class="fas fa-calendar me-1"></i>
                                            @review.CreatedAt.ToString("MMMM dd, yyyy")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-star fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No reviews yet</p>
                            <p class="text-muted small">Be the first to review this product!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (Model.RelatedProducts.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-leaf me-2"></i>Related Products
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var product in Model.RelatedProducts)
                            {
                                <div class="col-lg-3 col-md-6 mb-3">
                                    <div class="card h-100">
                                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 150px; object-fit: cover;">
                                        <div class="card-body d-flex flex-column">
                                            <h6 class="card-title">@product.Name</h6>
                                            <p class="card-text text-muted small">@product.Category.Name</p>
                                            <div class="mt-auto">
                                                <div class="fw-bold text-success mb-2">R @product.PricePerKg.ToString("N2")/kg</div>
                                                <div class="d-flex gap-1">
                                                    <a asp-action="ProductDetails" asp-route-id="@product.Id" class="btn btn-primary btn-sm flex-fill">
                                                        <i class="fas fa-eye me-1"></i>View
                                                    </a>
                                                    @if (product.IsAvailable)
                                                    {
                                                        <button class="btn btn-success btn-sm add-to-cart" data-product-id="@product.Id">
                                                            <i class="fas fa-cart-plus"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .avatar-sm {
        width: 40px;
        height: 40px;
    }
    
    .rating i {
        font-size: 0.9rem;
    }
    
    .favorite-btn {
        opacity: 0.7;
        transition: opacity 0.2s ease-in-out;
    }
    
    .favorite-btn:hover {
        opacity: 1;
    }
    
    .favorite-btn.favorited {
        color: #dc3545 !important;
        opacity: 1;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const quantityInput = document.getElementById('quantity');
        const totalPriceSpan = document.getElementById('totalPrice');
        const pricePerKg = @Model.Product.PricePerKg;
        
        // Update total price when quantity changes
        quantityInput.addEventListener('input', updateTotalPrice);
        
        // Add to cart functionality
        const addToCartButtons = document.querySelectorAll('.add-to-cart');
        
        addToCartButtons.forEach(button => {
            button.addEventListener('click', function() {
                const productId = this.dataset.productId;
                const quantity = productId == @Model.Product.Id ? parseInt(quantityInput.value) : 1;
                addToCart(productId, quantity);
            });
        });

        // Buy now functionality
        const buyNowButtons = document.querySelectorAll('.buy-now');
        
        buyNowButtons.forEach(button => {
            button.addEventListener('click', function() {
                const productId = this.dataset.productId;
                const quantity = productId == @Model.Product.Id ? parseInt(quantityInput.value) : 1;
                buyNow(productId, quantity);
            });
        });

        // Favorite functionality
        const favoriteButtons = document.querySelectorAll('.favorite-btn');
        
        favoriteButtons.forEach(button => {
            button.addEventListener('click', function() {
                const productId = this.dataset.productId;
                toggleFavorite(productId, this);
            });
        });
        
        // Load cart count
        loadCartCount();
    });

    function loadCartCount() {
        fetch('@Url.Action("GetCartCount", "Buyer")')
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                updateCartCount(data.count);
            }
        })
        .catch(error => {
            console.error('Error loading cart count:', error);
        });
    }

    function updateCartCount(count) {
        const cartBadge = document.querySelector('.cart-badge');
        if (cartBadge) {
            cartBadge.textContent = count;
            cartBadge.style.display = count > 0 ? 'inline' : 'none';
        }
    }

    function increaseQuantity() {
        const quantityInput = document.getElementById('quantity');
        const maxQuantity = @Model.Product.AvailableQuantity;
        if (parseInt(quantityInput.value) < maxQuantity) {
            quantityInput.value = parseInt(quantityInput.value) + 1;
            updateTotalPrice();
        }
    }

    function decreaseQuantity() {
        const quantityInput = document.getElementById('quantity');
        if (parseInt(quantityInput.value) > 1) {
            quantityInput.value = parseInt(quantityInput.value) - 1;
            updateTotalPrice();
        }
    }

    function updateTotalPrice() {
        const quantityInput = document.getElementById('quantity');
        const totalPriceSpan = document.getElementById('totalPrice');
        const pricePerKg = @Model.Product.PricePerKg;
        const total = pricePerKg * parseInt(quantityInput.value);
        totalPriceSpan.textContent = total.toFixed(2);
    }

    function buyNow(productId, quantity) {
        const formData = new FormData();
        formData.append('productId', productId);
        formData.append('quantity', quantity);
        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        
        fetch('@Url.Action("AddToCart", "Buyer")', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Redirect to checkout page
                window.location.href = '@Url.Action("Checkout", "Buyer")';
            } else {
                showToast(data.message, 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showToast('Error processing buy now', 'error');
        });
    }

    function addToCart(productId, quantity) {
        console.log('Product Details - Adding to cart:', productId, quantity);
        
        const formData = new FormData();
        formData.append('productId', productId);
        formData.append('quantity', quantity);
        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        
        console.log('Product Details - FormData created, sending request...');
        
        fetch('@Url.Action("AddToCart", "Buyer")', {
            method: 'POST',
            body: formData
        })
        .then(response => {
            console.log('Product Details - Response received:', response.status);
            return response.json();
        })
        .then(data => {
            console.log('Product Details - Response data:', data);
            if (data.success) {
                showToast('Added to cart!', 'success');
                updateCartCount(data.cartCount || 0);
            } else {
                showToast(data.message, 'error');
            }
        })
        .catch(error => {
            console.error('Product Details - Error:', error);
            showToast('Error adding to cart', 'error');
        });
    }

    function toggleFavorite(productId, button) {
        const isFavorited = button.classList.contains('favorited');
        
        const action = isFavorited ? "RemoveFromFavorites" : "AddToFavorites";
        fetch(`@Url.Action("AddToFavorites", "Buyer").Replace("AddToFavorites", "${action}")`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify({
                productId: parseInt(productId)
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                if (isFavorited) {
                    button.classList.remove('favorited');
                    showToast('Removed from favorites', 'info');
                } else {
                    button.classList.add('favorited');
                    showToast('Added to favorites', 'success');
                }
            } else {
                showToast(data.message, 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showToast('Error updating favorites', 'error');
        });
    }

    function showToast(message, type) {
        const toast = document.createElement('div');
        toast.className = `alert alert-${type === 'success' ? 'success' : type === 'error' ? 'danger' : 'info'} position-fixed`;
        toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        toast.textContent = message;
        
        document.body.appendChild(toast);
        
        setTimeout(() => {
            toast.remove();
        }, 3000);
    }
</script>
