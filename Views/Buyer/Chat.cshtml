@{
    ViewData["Title"] = "Chat";
    var farmer = ViewBag.Farmer as ReacodeApp.Models.User;
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center">
                    <a href="@Url.Action("Messages", "Buyer")" class="btn btn-outline-secondary me-3">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <div class="d-flex align-items-center">
                        <div class="avatar-circle me-3">
                            <i class="fas fa-user"></i>
                        </div>
                        <div>
                            <h4 class="mb-0">@farmer.FirstName @farmer.LastName</h4>
                            <small class="text-muted">@farmer.Email</small>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("Contact", "Home")" class="btn btn-outline-info btn-sm">
                        <i class="fas fa-headset me-1"></i>Support
                    </a>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-8">
                    <!-- Chat Messages -->
                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-comments me-2"></i>Conversation
                            </h5>
                        </div>
                        <div class="card-body" style="height: 500px; overflow-y: auto;" id="chatMessages">
                            <!-- Sample messages for demonstration -->
                            <div class="message-container">
                                <div class="message farmer-message">
                                    <div class="message-content">
                                        <div class="message-header">
                                            <strong>@farmer.FirstName @farmer.LastName</strong>
                                            <small class="text-muted">@DateTime.Now.AddMinutes(-30).ToString("h:mm tt")</small>
                                        </div>
                                        <div class="message-text">
                                            Hello! Thank you for your order. Your fresh produce will be ready for pickup tomorrow morning.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="message-container">
                                <div class="message buyer-message">
                                    <div class="message-content">
                                        <div class="message-header">
                                            <strong>You</strong>
                                            <small class="text-muted">@DateTime.Now.AddMinutes(-25).ToString("h:mm tt")</small>
                                        </div>
                                        <div class="message-text">
                                            Great! What time would be best for pickup?
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="message-container">
                                <div class="message farmer-message">
                                    <div class="message-content">
                                        <div class="message-header">
                                            <strong>@farmer.FirstName @farmer.LastName</strong>
                                            <small class="text-muted">@DateTime.Now.AddMinutes(-20).ToString("h:mm tt")</small>
                                        </div>
                                        <div class="message-text">
                                            Anytime between 8 AM and 5 PM works for me. Just let me know when you're on your way!
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="message-container">
                                <div class="message buyer-message">
                                    <div class="message-content">
                                        <div class="message-header">
                                            <strong>You</strong>
                                            <small class="text-muted">@DateTime.Now.AddMinutes(-15).ToString("h:mm tt")</small>
                                        </div>
                                        <div class="message-text">
                                            Perfect! I'll be there around 10 AM. Thank you for the fresh produce!
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Message Input -->
                        <div class="card-footer bg-light">
                            <form id="messageForm">
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="Type your message..." id="messageInput" required>
                                    <button class="btn btn-primary" type="submit">
                                        <i class="fas fa-paper-plane"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <!-- Farmer Information -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-user me-2"></i>Farmer Information
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="text-center mb-3">
                                <div class="avatar-circle mx-auto mb-2" style="width: 80px; height: 80px; font-size: 24px;">
                                    <i class="fas fa-user"></i>
                                </div>
                                <h5 class="mb-0">@farmer.FirstName @farmer.LastName</h5>
                                <small class="text-muted">@farmer.Email</small>
                            </div>
                            
                            <hr>
                            
                            <div class="mb-2">
                                <strong>Phone:</strong>
                                <span class="text-muted">@(farmer.PhoneNumber ?? "Not provided")</span>
                            </div>
                            
                            <div class="mb-2">
                                <strong>Location:</strong>
                                <span class="text-muted">@(farmer.City ?? "Not provided")</span>
                            </div>
                            
                            <div class="mb-2">
                                <strong>Member Since:</strong>
                                <span class="text-muted">@farmer.CreatedAt.ToString("MMM yyyy")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-bolt me-2"></i>Quick Actions
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <a href="@Url.Action("Shop", "Buyer")" class="btn btn-outline-success">
                                    <i class="fas fa-shopping-cart me-1"></i>Browse Products
                                </a>
                                <a href="@Url.Action("OrdersHistory", "Buyer")" class="btn btn-outline-primary">
                                    <i class="fas fa-history me-1"></i>Order History
                                </a>
                                <a href="@Url.Action("Favorites", "Buyer")" class="btn btn-outline-danger">
                                    <i class="fas fa-heart me-1"></i>My Favorites
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Chat Guidelines -->
                    <div class="card shadow-sm">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>Chat Guidelines
                            </h5>
                        </div>
                        <div class="card-body">
                            <ul class="list-unstyled mb-0">
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <small>Be respectful and professional</small>
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <small>Ask about product availability</small>
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <small>Discuss pickup/delivery times</small>
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <small>Report any issues with orders</small>
                                </li>
                                <li>
                                    <i class="fas fa-times text-danger me-2"></i>
                                    <small>No spam or inappropriate content</small>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1FAA59, #28a745);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .message-container {
        margin-bottom: 15px;
    }

    .message {
        max-width: 70%;
        margin-bottom: 10px;
    }

    .farmer-message {
        margin-right: auto;
    }

    .buyer-message {
        margin-left: auto;
    }

    .message-content {
        padding: 12px 16px;
        border-radius: 18px;
        position: relative;
    }

    .farmer-message .message-content {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
    }

    .buyer-message .message-content {
        background-color: #1FAA59;
        color: white;
    }

    .message-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 5px;
    }

    .message-header strong {
        font-size: 0.9rem;
    }

    .message-header small {
        font-size: 0.75rem;
    }

    .message-text {
        font-size: 0.95rem;
        line-height: 1.4;
    }

    .card {
        border: none;
        border-radius: 12px;
    }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
        border: none;
    }

    .card-footer {
        border-radius: 0 0 12px 12px !important;
        border: none;
    }

    .form-control {
        border-radius: 25px;
        border: 1px solid #dee2e6;
    }

    .form-control:focus {
        border-color: #1FAA59;
        box-shadow: 0 0 0 0.2rem rgba(31, 170, 89, 0.25);
    }

    .btn {
        border-radius: 25px;
    }

    .list-unstyled li {
        font-size: 0.9rem;
    }
</style>

<script>
    // Simple chat functionality (in a real app, you'd use SignalR)
    document.getElementById('messageForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const messageInput = document.getElementById('messageInput');
        const message = messageInput.value.trim();
        
        if (message) {
            addMessage(message, 'buyer');
            messageInput.value = '';
            
            // Simulate farmer response after 2 seconds
            setTimeout(() => {
                const responses = [
                    "Thank you for your message! I'll get back to you soon.",
                    "I'll check on that for you right away.",
                    "Great question! Let me look into that.",
                    "I appreciate your feedback.",
                    "Is there anything else I can help you with?"
                ];
                const randomResponse = responses[Math.floor(Math.random() * responses.length)];
                addMessage(randomResponse, 'farmer');
            }, 2000);
        }
    });

    function addMessage(text, sender) {
        const chatMessages = document.getElementById('chatMessages');
        const messageContainer = document.createElement('div');
        messageContainer.className = 'message-container';
        
        const messageDiv = document.createElement('div');
        messageDiv.className = `message ${sender}-message`;
        
        const now = new Date();
        const timeString = now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
        
        messageDiv.innerHTML = `
            <div class="message-content">
                <div class="message-header">
                    <strong>${sender === 'buyer' ? 'You' : '@farmer.FirstName @farmer.LastName'}</strong>
                    <small class="text-muted">${timeString}</small>
                </div>
                <div class="message-text">${text}</div>
            </div>
        `;
        
        messageContainer.appendChild(messageDiv);
        chatMessages.appendChild(messageContainer);
        
        // Scroll to bottom
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    // Auto-scroll to bottom on page load
    document.addEventListener('DOMContentLoaded', function() {
        const chatMessages = document.getElementById('chatMessages');
        chatMessages.scrollTop = chatMessages.scrollHeight;
    });
</script>
