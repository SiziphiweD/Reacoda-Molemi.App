@model AddProductViewModel
@{
    ViewData["Title"] = "Add Product";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header text-center py-4 bg-success text-white">
                    <h3 class="fw-bold mb-0">
                        <i class="fas fa-plus me-2"></i>Add New Product
                    </h3>
                    <p class="mb-0">List your fresh produce for sale</p>
                </div>
                <div class="card-body p-5">
                    <form asp-action="AddProduct" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Name" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-tag"></i>
                                    </span>
                                    <input asp-for="Name" class="form-control" placeholder="Product name" />
                                </div>
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="CategoryId" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-list"></i>
                                    </span>
                                    <select asp-for="CategoryId" class="form-select">
                                        <option value="">Select Category</option>
                                        @foreach (var category in Model.Categories)
                                        {
                                            <option value="@category.Id">@category.Name</option>
                                        }
                                    </select>
                                </div>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-align-left"></i>
                                </span>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe your product..."></textarea>
                            </div>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="PricePerKg" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R</span>
                                    <input asp-for="PricePerKg" class="form-control" placeholder="0.00" step="0.01" />
                                </div>
                                <span asp-validation-for="PricePerKg" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="AvailableQuantity" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-weight"></i>
                                    </span>
                                    <input asp-for="AvailableQuantity" class="form-control" placeholder="Quantity in kg" />
                                    <span class="input-group-text">kg</span>
                                </div>
                                <span asp-validation-for="AvailableQuantity" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Location" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-map-marker-alt"></i>
                                </span>
                                <input asp-for="Location" class="form-control" placeholder="Farm location or city" />
                            </div>
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="HarvestDate" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-calendar"></i>
                                    </span>
                                    <input asp-for="HarvestDate" class="form-control" type="date" />
                                </div>
                                <span asp-validation-for="HarvestDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="ExpiryDate" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-calendar-times"></i>
                                    </span>
                                    <input asp-for="ExpiryDate" class="form-control" type="date" />
                                </div>
                                <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ImageUrl" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-image"></i>
                                </span>
                                <input asp-for="ImageUrl" class="form-control" placeholder="Image URL (optional)" />
                            </div>
                            <div class="form-text">
                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    You can provide an image URL or upload an image file. If no image is provided, a default image will be used.
                                </small>
                            </div>
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="MyProducts" class="btn btn-secondary me-md-2">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-plus me-2"></i>Add Product
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Auto-calculate expiry date based on harvest date
        document.getElementById('HarvestDate').addEventListener('change', function() {
            const harvestDate = new Date(this.value);
            if (harvestDate && !isNaN(harvestDate.getTime())) {
                // Set expiry date to 7 days after harvest date
                const expiryDate = new Date(harvestDate);
                expiryDate.setDate(expiryDate.getDate() + 7);
                
                const expiryInput = document.getElementById('ExpiryDate');
                expiryInput.value = expiryDate.toISOString().split('T')[0];
            }
        });

        // Form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const price = parseFloat(document.getElementById('PricePerKg').value);
            const quantity = parseInt(document.getElementById('AvailableQuantity').value);
            
            if (price <= 0) {
                alert('Price per kg must be greater than 0.');
                e.preventDefault();
                return;
            }
            
            if (quantity <= 0) {
                alert('Available quantity must be greater than 0.');
                e.preventDefault();
                return;
            }
        });
    </script>
}