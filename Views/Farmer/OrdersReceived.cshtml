@model List<Order>
@{
    ViewData["Title"] = "Orders Received";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="row mb-5">
        <div class="col-12 text-center">
            <div class="service-section-header">
                <div class="service-section-icon">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <h2 class="service-section-title">Orders Received</h2>
                <p class="service-section-subtitle">@Model.Count orders total - Manage and track your orders</p>
            </div>
        </div>
    </div>
            
    @if (TempData["Error"] != null)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        </div>
    }
            
    @if (TempData["Message"] != null)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Message"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        </div>
    }

    @if (Model.Any())
    {
        <div class="orders-grid-farmer">
            @foreach (var order in Model)
            {
                <div class="order-card-modern-farmer @(ViewBag.HighlightOrderId != null && ViewBag.HighlightOrderId == order.Id ? "highlighted" : "")" id="order-@order.Id">
                    <div class="order-card-header-farmer">
                        <div class="order-number-section">
                            <div class="order-icon-wrapper">
                                <i class="fas fa-shopping-bag"></i>
                            </div>
                            <div>
                                <div class="order-number-farmer">#@order.OrderNumber</div>
                                <small class="order-date-farmer">
                                    <i class="fas fa-calendar me-1"></i>@order.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                </small>
                            </div>
                        </div>
                        <span class="order-status-badge-farmer badge-@(order.Status switch {
                            OrderStatus.Pending => "warning",
                            OrderStatus.Accepted => "info",
                            OrderStatus.Rejected => "danger",
                            OrderStatus.Shipped => "primary",
                            OrderStatus.Arrived => "info",
                            OrderStatus.Delivered => "success",
                            OrderStatus.Cancelled => "danger",
                            _ => "secondary"
                        })">@order.Status</span>
                    </div>

                    <div class="order-card-body-farmer">
                        <div class="order-buyer-section-farmer">
                            <div class="buyer-avatar-farmer">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="buyer-info-farmer">
                                @if (order.Buyer != null)
                                {
                                    <div class="buyer-name-farmer">@order.Buyer.FirstName @order.Buyer.LastName</div>
                                    <div class="buyer-email-farmer">@order.Buyer.Email</div>
                                }
                                else
                                {
                                    <div class="buyer-name-farmer text-muted">Unknown Buyer</div>
                                    <div class="buyer-email-farmer text-muted">N/A</div>
                                }
                            </div>
                        </div>

                        <div class="order-items-section-farmer">
                            <div class="order-items-count-farmer">
                                <i class="fas fa-box me-2"></i>
                                @if (order.OrderItems != null && order.OrderItems.Any())
                                {
                                    <span>@order.OrderItems.Count items</span>
                                }
                                else
                                {
                                    <span>No items</span>
                                }
                            </div>
                            @if (order.OrderItems != null && order.OrderItems.Any())
                            {
                                <div class="order-items-list-farmer">
                                    @string.Join(", ", order.OrderItems.Where(oi => oi.Product != null).Select(oi => oi.Product!.Name).Take(3))
                                    @if (order.OrderItems.Count > 3)
                                    {
                                        <span class="text-muted">+@(order.OrderItems.Count - 3) more</span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="order-amount-section-farmer">
                            <div class="amount-label-farmer">Total Amount</div>
                            <div class="amount-value-farmer">R @order.TotalAmount.ToString("N2")</div>
                        </div>

                        @if (order.Status == OrderStatus.Pending && order.ResponseDeadline.HasValue)
                        {
                            var timeRemaining = order.ResponseDeadline.Value - DateTime.UtcNow;
                            <div class="order-deadline-farmer @(timeRemaining.TotalMinutes > 0 ? "deadline-active" : "deadline-passed")">
                                <i class="fas fa-clock me-2"></i>
                                @if (timeRemaining.TotalMinutes > 0)
                                {
                                    <span>@((int)timeRemaining.TotalMinutes) minutes remaining</span>
                                }
                                else
                                {
                                    <span>Deadline passed</span>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(order.RejectionReason))
                        {
                            <div class="order-rejection-reason-farmer">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                <strong>Rejection Reason:</strong> @order.RejectionReason
                            </div>
                        }

                        @if (order.Status == OrderStatus.Accepted && order.EstimatedDeliveryDate.HasValue)
                        {
                            <div class="order-delivery-info-farmer">
                                <i class="fas fa-truck me-2"></i>
                                <span>Est. Delivery: @order.EstimatedDeliveryDate.Value.ToString("MMM dd, yyyy")</span>
                            </div>
                        }

                        @if (order.Status == OrderStatus.Shipped && !string.IsNullOrWhiteSpace(order.TrackingNumber))
                        {
                            <div class="order-tracking-info-farmer">
                                <i class="fas fa-shipping-fast me-2"></i>
                                <span>Tracking: @order.TrackingNumber</span>
                            </div>
                        }
                    </div>

                    <div class="order-card-footer-farmer">
                        <a asp-action="OrderDetails" asp-route-id="@order.Id" class="order-btn-view">
                            <i class="fas fa-eye me-1"></i>View Details
                        </a>
                        
                        @if (order.Status == OrderStatus.Pending)
                        {
                            var canRespond = !order.ResponseDeadline.HasValue || DateTime.UtcNow <= order.ResponseDeadline.Value;
                            @if (canRespond)
                            {
                                <form asp-action="AcceptOrder" asp-route-id="@order.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="order-btn-accept" onclick="return confirm('Accept this order?')">
                                        <i class="fas fa-check me-1"></i>Accept
                                    </button>
                                </form>
                                <a asp-action="RejectOrder" asp-route-id="@order.Id" class="order-btn-reject">
                                    <i class="fas fa-times me-1"></i>Reject
                                </a>
                            }
                            else
                            {
                                <button class="order-btn-disabled" disabled>
                                    <i class="fas fa-clock me-1"></i>Deadline Passed
                                </button>
                            }
                        }
                        else if (order.Status == OrderStatus.Accepted)
                        {
                            <a asp-action="MarkShipped" asp-route-id="@order.Id" class="order-btn-ship">
                                <i class="fas fa-truck me-1"></i>Mark as Shipped
                            </a>
                        }
                        else if (order.Status == OrderStatus.Shipped)
                        {
                            <form asp-action="MarkAsArrived" asp-route-id="@order.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="order-btn-arrived" onclick="return confirm('Mark as arrived at delivery location?')">
                                    <i class="fas fa-map-marker-alt me-1"></i>Mark as Arrived
                                </button>
                            </form>
                            @if (order.Buyer != null)
                            {
                                <a href="tel:@order.Buyer.PhoneNumber" class="order-btn-call" title="Call Buyer">
                                    <i class="fas fa-phone me-1"></i>Call
                                </a>
                                <a href="sms:@order.Buyer.PhoneNumber" class="order-btn-message" title="Message Buyer">
                                    <i class="fas fa-sms me-1"></i>Message
                                </a>
                            }
                        }
                        else if (order.Status == OrderStatus.Arrived)
                        {
                            @if (order.Buyer != null)
                            {
                                <a href="tel:@order.Buyer.PhoneNumber" class="order-btn-call" title="Call Buyer">
                                    <i class="fas fa-phone me-1"></i>Call
                                </a>
                                <a href="sms:@order.Buyer.PhoneNumber" class="order-btn-message" title="Message Buyer">
                                    <i class="fas fa-sms me-1"></i>Message
                                </a>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="empty-state">
                    <i class="fas fa-shopping-cart empty-state-icon"></i>
                    <h4 class="empty-state-title">No Orders Yet</h4>
                    <p class="empty-state-text">Orders from buyers will appear here once they start purchasing your products.</p>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .orders-grid-farmer {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 2rem;
        padding: 0;
    }

    .order-card-modern-farmer {
        background: var(--accent-white);
        border-radius: var(--border-radius-lg);
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-light);
        transition: var(--transition);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .order-card-modern-farmer:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
        border-color: var(--primary-green);
    }

    .order-card-modern-farmer.highlighted {
        border: 2px solid #F39C12;
        box-shadow: 0 4px 16px rgba(243, 156, 18, 0.3);
    }

    .order-card-header-farmer {
        background: linear-gradient(135deg, var(--primary-green), #17A085);
        color: white;
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .order-number-section {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .order-icon-wrapper {
        width: 48px;
        height: 48px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .order-icon-wrapper i {
        font-size: 1.25rem;
        color: white;
    }

    .order-number-farmer {
        font-family: 'Poppins', sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        color: white;
    }

    .order-date-farmer {
        color: rgba(255, 255, 255, 0.9);
        font-size: 0.85rem;
    }

    .order-status-badge-farmer {
        padding: 0.5rem 1rem;
        border-radius: var(--border-radius-sm);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .badge-warning { background: #F39C12; color: white; }
    .badge-info { background: #3498DB; color: white; }
    .badge-primary { background: #3498DB; color: white; }
    .badge-success { background: #27AE60; color: white; }
    .badge-danger { background: var(--primary-red); color: white; }
    .badge-secondary { background: var(--text-muted); color: white; }

    .order-card-body-farmer {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        flex: 1;
    }

    .order-buyer-section-farmer {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: var(--accent-cream);
        border-radius: var(--border-radius);
    }

    .buyer-avatar-farmer {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, var(--primary-green), #17A085);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.25rem;
    }

    .buyer-info-farmer {
        flex: 1;
    }

    .buyer-name-farmer {
        font-family: 'Poppins', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 0.25rem;
    }

    .buyer-email-farmer {
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .order-items-section-farmer {
        padding: 1rem;
        background: var(--accent-cream);
        border-radius: var(--border-radius);
    }

    .order-items-count-farmer {
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 0.5rem;
    }

    .order-items-list-farmer {
        font-size: 0.9rem;
        color: var(--text-muted);
        line-height: 1.6;
    }

    .order-amount-section-farmer {
        text-align: center;
        padding: 1rem;
        background: linear-gradient(135deg, rgba(31, 170, 89, 0.1), rgba(23, 160, 133, 0.1));
        border-radius: var(--border-radius);
    }

    .amount-label-farmer {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
    }

    .amount-value-farmer {
        font-family: 'Poppins', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--primary-green);
    }

    .order-deadline-farmer {
        padding: 0.75rem 1rem;
        border-radius: var(--border-radius);
        font-size: 0.9rem;
        font-weight: 600;
        text-align: center;
    }

    .deadline-active {
        background: #FFF3CD;
        color: #856404;
        border: 1px solid #FFE69C;
    }

    .deadline-passed {
        background: #F8D7DA;
        color: #721C24;
        border: 1px solid #F5C6CB;
    }

    .order-rejection-reason-farmer {
        padding: 0.75rem 1rem;
        background: #F8D7DA;
        color: #721C24;
        border-radius: var(--border-radius);
        font-size: 0.9rem;
        border-left: 4px solid var(--primary-red);
    }

    .order-delivery-info-farmer,
    .order-tracking-info-farmer {
        padding: 0.75rem 1rem;
        background: #D1ECF1;
        color: #0C5460;
        border-radius: var(--border-radius);
        font-size: 0.9rem;
        border-left: 4px solid #3498DB;
    }

    .order-card-footer-farmer {
        padding: 1.5rem;
        background: var(--accent-cream);
        border-top: 1px solid var(--border-light);
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .order-btn-view,
    .order-btn-accept,
    .order-btn-reject,
    .order-btn-ship,
    .order-btn-arrived,
    .order-btn-call,
    .order-btn-message,
    .order-btn-disabled {
        flex: 1;
        min-width: 120px;
        padding: 0.75rem 1rem;
        border-radius: var(--border-radius-sm);
        border: none;
        cursor: pointer;
        transition: var(--transition);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        text-align: center;
    }

    .order-btn-view {
        background: linear-gradient(135deg, #3498DB, #2980B9);
        color: white;
        box-shadow: 0 4px 12px rgba(52, 152, 219, 0.25);
    }

    .order-btn-view:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(52, 152, 219, 0.35);
        color: white;
    }

    .order-btn-accept {
        background: linear-gradient(135deg, var(--primary-green), #17A085);
        color: white;
        box-shadow: 0 4px 12px rgba(31, 170, 89, 0.25);
    }

    .order-btn-accept:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(31, 170, 89, 0.35);
        color: white;
    }

    .order-btn-reject {
        background: var(--primary-red);
        color: white;
        box-shadow: 0 4px 12px rgba(231, 76, 60, 0.25);
    }

    .order-btn-reject:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(231, 76, 60, 0.35);
        color: white;
    }

    .order-btn-ship {
        background: #F39C12;
        color: white;
        box-shadow: 0 4px 12px rgba(243, 156, 18, 0.25);
    }

    .order-btn-ship:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(243, 156, 18, 0.35);
        color: white;
    }

    .order-btn-arrived {
        background: #3498DB;
        color: white;
        box-shadow: 0 4px 12px rgba(52, 152, 219, 0.25);
    }

    .order-btn-arrived:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(52, 152, 219, 0.35);
        color: white;
    }

    .order-btn-call {
        background: #27AE60;
        color: white;
        box-shadow: 0 4px 12px rgba(39, 174, 96, 0.25);
    }

    .order-btn-call:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(39, 174, 96, 0.35);
        color: white;
    }

    .order-btn-message {
        background: #3498DB;
        color: white;
        box-shadow: 0 4px 12px rgba(52, 152, 219, 0.25);
    }

    .order-btn-message:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(52, 152, 219, 0.35);
        color: white;
    }

    .order-btn-disabled {
        background: var(--text-muted);
        color: white;
        opacity: 0.6;
        cursor: not-allowed;
    }

    @@media (max-width: 1200px) {
        .orders-grid-farmer {
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.75rem;
        }
    }

    @@media (max-width: 992px) {
        .orders-grid-farmer {
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.5rem;
        }
    }

    @@media (max-width: 768px) {
        .orders-grid-farmer {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }
</style>
