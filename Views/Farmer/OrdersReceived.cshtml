@model List<Order>
@{
    ViewData["Title"] = "Orders Received";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-success">
                    <i class="fas fa-shopping-cart me-2"></i>Orders Received
                </h2>
                <div class="text-muted">
                    @Model.Count orders total
                </div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order #</th>
                                        <th>Buyer</th>
                                        <th>Items</th>
                                        <th>Total Amount</th>
                                        <th>Status</th>
                                        <th>Order Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>#@order.Id</strong>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-sm bg-primary rounded-circle d-flex align-items-center justify-content-center me-2">
                                                        <i class="fas fa-user text-white"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold">@order.Buyer.FirstName @order.Buyer.LastName</div>
                                                        <small class="text-muted">@order.Buyer.Email</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@order.OrderItems.Count items</span>
                                                <div class="small text-muted">
                                                    @string.Join(", ", order.OrderItems.Select(oi => oi.Product.Name).Take(2))
                                                    @if (order.OrderItems.Count > 2)
                                                    {
                                                        <span>...</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <strong class="text-success">R @order.TotalAmount.ToString("N2")</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-@(order.Status switch {
                                                    OrderStatus.Pending => "warning",
                                                    OrderStatus.Accepted => "info",
                                                    OrderStatus.Shipped => "primary",
                                                    OrderStatus.Delivered => "success",
                                                    OrderStatus.Cancelled => "danger",
                                                    _ => "secondary"
                                                }) fs-6">
                                                    @order.Status
                                                </span>
                                            </td>
                                            <td>
                                                <div>@order.CreatedAt.ToString("MMM dd, yyyy")</div>
                                                <small class="text-muted">@order.CreatedAt.ToString("HH:mm")</small>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">
                                                        <i class="fas fa-eye me-1"></i>View
                                                    </a>
                                                    @if (order.Status == OrderStatus.Pending)
                                                    {
                                                        <form asp-action="AcceptOrder" asp-route-id="@order.Id" method="post" class="d-inline">
                                                            <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Accept this order?')">
                                                                <i class="fas fa-check me-1"></i>Accept
                                                            </button>
                                                        </form>
                                                        <form asp-action="RejectOrder" asp-route-id="@order.Id" method="post" class="d-inline">
                                                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Reject this order?')">
                                                                <i class="fas fa-times me-1"></i>Reject
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (order.Status == OrderStatus.Accepted)
                                                    {
                                                        <form asp-action="MarkShipped" asp-route-id="@order.Id" method="post" class="d-inline">
                                                            <button type="submit" class="btn btn-warning btn-sm" onclick="return confirm('Mark as shipped?')">
                                                                <i class="fas fa-truck me-1"></i>Ship
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Statistics -->
        <div class="row mt-4">
            <div class="col-md-3 mb-3">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="text-white-50 small">Pending Orders</div>
                                <div class="h4">@Model.Count(o => o.Status == OrderStatus.Pending)</div>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-clock fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="text-white-50 small">Confirmed Orders</div>
                                <div class="h4">@Model.Count(o => o.Status == OrderStatus.Accepted)</div>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-check-circle fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="text-white-50 small">Shipped Orders</div>
                                <div class="h4">@Model.Count(o => o.Status == OrderStatus.Shipped)</div>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-truck fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="text-white-50 small">Delivered Orders</div>
                                <div class="h4">@Model.Count(o => o.Status == OrderStatus.Delivered)</div>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-gift fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-shopping-cart fa-4x text-muted mb-4"></i>
                        <h4 class="text-muted mb-3">No Orders Yet</h4>
                        <p class="text-muted mb-4">When buyers place orders for your products, they will appear here.</p>
                        <a asp-action="MyProducts" class="btn btn-success">
                            <i class="fas fa-boxes me-2"></i>Manage Products
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .avatar-sm {
        width: 32px;
        height: 32px;
    }
    
    .table th {
        border-top: none;
        font-weight: 600;
    }
    
    .btn-group .btn {
        margin-right: 2px;
    }
    
    .btn-group .btn:last-child {
        margin-right: 0;
    }
</style>
