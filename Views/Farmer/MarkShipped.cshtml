@model Order
@{
    ViewData["Title"] = "Mark Order as Shipped";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-truck me-2"></i>Mark Order #@Model.OrderNumber as Shipped
                    </h5>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Order Details -->
                    <div class="mb-4">
                        <h6 class="fw-bold mb-3">Order Details</h6>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <strong>Buyer:</strong> @Model.Buyer.FirstName @Model.Buyer.LastName
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Total Amount:</strong> R @Model.TotalAmount.ToString("N2")
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Order Date:</strong> @Model.CreatedAt.ToString("MMMM dd, yyyy HH:mm")
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Delivery Address:</strong> @Model.DeliveryAddress, @Model.DeliveryCity
                            </div>
                        </div>
                    </div>

                    <hr>

                    <!-- Shipping Form -->
                    <form asp-action="MarkShipped" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        
                        <div class="mb-3">
                            <label for="trackingNumber" class="form-label fw-bold">
                                <i class="fas fa-barcode me-2"></i>Tracking Number (Optional)
                            </label>
                            <input type="text" id="trackingNumber" name="trackingNumber" class="form-control" 
                                   placeholder="Enter tracking number if available" />
                            <small class="text-muted">If you have a tracking number from the shipping company, enter it here.</small>
                        </div>

                        <div class="mb-4">
                            <label for="estimatedDeliveryDate" class="form-label fw-bold">
                                <i class="fas fa-calendar-alt me-2"></i>Estimated Delivery Date <span class="text-danger">*</span>
                            </label>
                            <input type="date" id="estimatedDeliveryDate" name="estimatedDeliveryDate" class="form-control" 
                                   min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" 
                                   value="@(Model.EstimatedDeliveryDate?.ToString("yyyy-MM-dd") ?? DateTime.Now.AddDays(3).ToString("yyyy-MM-dd"))" 
                                   required />
                            <small class="text-muted">When do you expect this order to be delivered to the buyer?</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-truck me-2"></i>Mark as Shipped
                            </button>
                            <a asp-action="OrdersReceived" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>






