@model List<Product>
@{
    ViewData["Title"] = "My Products";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-success">
                    <i class="fas fa-boxes me-2"></i>My Products
                </h2>
                <a asp-action="AddProduct" class="btn btn-success">
                    <i class="fas fa-plus me-2"></i>Add New Product
                </a>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var product in Model)
            {
                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 mb-4">
                    <div class="card shadow h-100">
                        <div class="position-relative">
                            <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 150px; object-fit: cover;">
                            <div class="position-absolute top-0 end-0 m-2">
                                @if (product.IsAvailable)
                                {
                                    <span class="badge bg-success">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Out of Stock</span>
                                }
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column p-2">
                            <h6 class="card-title text-success mb-1" style="font-size: 0.9rem;">@product.Name</h6>
                            <p class="card-text text-muted mb-2" style="font-size: 0.75rem; line-height: 1.2;">@(product.Description.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description)</p>
                            <div class="mt-auto">
                                <div class="mb-2">
                                    <small class="text-muted d-block">Price:</small>
                                    <div class="fw-bold text-success" style="font-size: 0.9rem;">R @product.PricePerKg.ToString("N2")/kg</div>
                                </div>
                                <div class="mb-2">
                                    <small class="text-muted d-block">Available:</small>
                                    <div class="fw-bold" style="font-size: 0.8rem;">@product.AvailableQuantity kg</div>
                                </div>
                                <div class="mb-2">
                                    <small class="text-muted d-block">Category:</small>
                                    <div class="fw-bold" style="font-size: 0.8rem;">@product.Category.Name</div>
                                </div>
                                <div class="d-grid gap-1">
                                    <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-primary btn-sm">
                                        <i class="fas fa-edit me-1"></i>Edit
                                    </a>
                                    @if (product.IsAvailable)
                                    {
                                        <form asp-action="ToggleAvailability" asp-route-id="@product.Id" method="post">
                                            <button type="submit" class="btn btn-warning btn-sm w-100">
                                                <i class="fas fa-pause me-1"></i>Mark Unavailable
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ToggleAvailability" asp-route-id="@product.Id" method="post">
                                            <button type="submit" class="btn btn-success btn-sm w-100">
                                                <i class="fas fa-play me-1"></i>Mark Available
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="card-footer text-muted p-2">
                            <small style="font-size: 0.7rem;">
                                <i class="fas fa-calendar me-1"></i>
                                Added @product.CreatedAt.ToString("MMM dd")
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-boxes fa-4x text-muted mb-4"></i>
                        <h4 class="text-muted mb-3">No Products Yet</h4>
                        <p class="text-muted mb-4">Start by adding your first product to begin selling on Reacoda Molemi.</p>
                        <a asp-action="AddProduct" class="btn btn-success btn-lg">
                            <i class="fas fa-plus me-2"></i>Add Your First Product
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Toggle Availability Modal -->
<div class="modal fade" id="toggleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to change the availability status of this product?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmToggle">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Handle toggle availability
    document.addEventListener('DOMContentLoaded', function() {
        const toggleForms = document.querySelectorAll('form[asp-action="ToggleAvailability"]');
        toggleForms.forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                const modal = new bootstrap.Modal(document.getElementById('toggleModal'));
                modal.show();
                
                document.getElementById('confirmToggle').onclick = function() {
                    form.submit();
                };
            });
        });
    });
</script>
