@model Order
@{
    ViewData["Title"] = "Reject Order";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-times-circle me-2"></i>Reject Order #@Model.OrderNumber
                    </h5>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Warning:</strong> Rejecting this order will restore product quantities and notify the buyer.
                    </div>

                    <!-- Order Details -->
                    <div class="mb-4">
                        <h6 class="fw-bold mb-3">Order Details</h6>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <strong>Buyer:</strong> @Model.Buyer.FirstName @Model.Buyer.LastName
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Total Amount:</strong> R @Model.TotalAmount.ToString("N2")
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Order Date:</strong> @Model.CreatedAt.ToString("MMMM dd, yyyy HH:mm")
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Items:</strong> @Model.OrderItems.Count item(s)
                            </div>
                        </div>
                        <div class="mt-3">
                            <strong>Products:</strong>
                            <ul class="list-unstyled mt-2">
                                @foreach (var item in Model.OrderItems)
                                {
                                    <li>
                                        <i class="fas fa-check text-success me-2"></i>
                                        @item.Product.Name - @item.Quantity kg × R @item.UnitPrice.ToString("N2")
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    <hr>

                    <!-- Rejection Form -->
                    <form asp-action="RejectOrder" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        
                        <div class="mb-4">
                            <label for="rejectionReason" class="form-label fw-bold">
                                <i class="fas fa-comment-alt me-2"></i>Rejection Reason <span class="text-danger">*</span>
                            </label>
                            <textarea id="rejectionReason" name="rejectionReason" class="form-control" rows="5" 
                                      placeholder="Please provide a clear reason for rejecting this order. This will be sent to the buyer." 
                                      required></textarea>
                            <small class="text-muted">This reason will be included in the notification sent to the buyer.</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-times me-2"></i>Reject Order
                            </button>
                            <a asp-action="OrdersReceived" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>






