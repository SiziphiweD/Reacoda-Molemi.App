@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<section class="login-section">
    <div class="container">
        <div class="row justify-content-center py-5">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="login-card">
                    <div class="login-card-header">
                        <div class="login-icon">
                            <i class="fas fa-sign-in-alt"></i>
                        </div>
                        <h1 class="login-title">Welcome Back</h1>
                        <p class="login-subtitle">Sign in to your account to continue</p>
                    </div>
                    <div class="login-card-body">
                        <form action="@Url.Action("Login", "Auth")" method="post" class="login-form">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="login-error-alert" role="alert"></div>
                            
                            <div class="form-group-login">
                                <label asp-for="Email" class="form-label-login">
                                    <i class="fas fa-envelope"></i>
                                    Email Address
                                </label>
                                <input asp-for="Email" class="form-input-login" placeholder="Enter your email address" />
                                <span asp-validation-for="Email" class="form-error"></span>
                            </div>

                            <div class="form-group-login">
                                <label asp-for="Password" class="form-label-login">
                                    <i class="fas fa-lock"></i>
                                    Password
                                </label>
                                <input asp-for="Password" class="form-input-login" placeholder="Enter your password" />
                                <span asp-validation-for="Password" class="form-error"></span>
                            </div>

                            <div class="login-options">
                                <div class="remember-me">
                                    <input asp-for="RememberMe" class="remember-checkbox" id="rememberMe" />
                                    <label for="rememberMe" class="remember-label">Remember me</label>
                                </div>
                                <a asp-action="ForgotPassword" class="forgot-password-link">
                                    Forgot Password?
                                </a>
                            </div>

                            <input asp-for="ReturnUrl" type="hidden" />

                            <div class="login-actions">
                                <button type="submit" class="btn-login-submit">
                                    <i class="fas fa-sign-in-alt"></i>
                                    <span>Sign In</span>
                                </button>
                            </div>

                            <div class="login-footer">
                                <p class="login-signup-text">
                                    Don't have an account? 
                                    <a asp-action="Register" class="login-signup-link">
                                        Sign up here
                                    </a>
                                </p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
