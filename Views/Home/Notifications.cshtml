@section Scripts {
    <script>
        // Update relative time for all timestamps
        function updateRelativeTimes() {
            const timestamps = document.querySelectorAll('[data-timestamp]');
            const now = new Date();
            
            timestamps.forEach(element => {
                const timestampStr = element.getAttribute('data-timestamp');
                if (!timestampStr) return;
                
                const timestamp = new Date(timestampStr);
                const timeSpan = now - timestamp;
                const relativeTimeSpan = element.querySelector('.relative-time');
                
                if (!relativeTimeSpan) return;
                
                let relativeTime = '';
                
                if (timeSpan < 60000) { // Less than 1 minute
                    relativeTime = 'just now';
                } else if (timeSpan < 3600000) { // Less than 1 hour
                    const minutes = Math.floor(timeSpan / 60000);
                    relativeTime = `${minutes} minute${minutes === 1 ? '' : 's'} ago`;
                } else if (timeSpan < 86400000) { // Less than 24 hours
                    const hours = Math.floor(timeSpan / 3600000);
                    relativeTime = `${hours} hour${hours === 1 ? '' : 's'} ago`;
                } else if (timeSpan < 604800000) { // Less than 7 days
                    const days = Math.floor(timeSpan / 86400000);
                    relativeTime = `${days} day${days === 1 ? '' : 's'} ago`;
                } else {
                    // Show absolute time for older notifications
                    const absoluteTimeSpan = element.querySelector('.absolute-time');
                    if (absoluteTimeSpan) {
                        relativeTime = absoluteTimeSpan.textContent;
                    } else {
                        relativeTime = timestamp.toLocaleDateString('en-US', { 
                            month: 'short', 
                            day: 'numeric', 
                            year: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                        });
                    }
                }
                
                relativeTimeSpan.textContent = relativeTime;
            });
        }
        
        // Update timestamps every 30 seconds
        setInterval(updateRelativeTimes, 30000);
        
        // Initial update
        updateRelativeTimes();
        
        // Mark notification as read
        function markAsRead(notificationId) {
            // Simulate API call
            setTimeout(() => {
                const card = document.querySelector(`[data-notification-id="${notificationId}"]`);
                if (card) {
                    card.classList.remove('unread');
                    const badge = card.querySelector('.badge-danger');
                    if (badge) {
                        badge.remove();
                    }
                    const markReadBtn = card.querySelector('button[onclick*="markAsRead"]');
                    if (markReadBtn) {
                        markReadBtn.remove();
                    }
                }
                showAlert('Notification marked as read', 'success');
            }, 500);
        }
        
        // Delete notification
        function deleteNotification(notificationId) {
            if (confirm('Are you sure you want to delete this notification?')) {
                // Simulate API call
                setTimeout(() => {
                    const card = document.querySelector(`[data-notification-id="${notificationId}"]`);
                    if (card) {
                        card.remove();
                    }
                    showAlert('Notification deleted', 'success');
                }, 500);
            }
        }
        
        // Mark all as read
        function markAllAsRead() {
            if (confirm('Mark all notifications as read?')) {
                // Simulate API call
                setTimeout(() => {
                    const unreadCards = document.querySelectorAll('.notification-card.unread');
                    unreadCards.forEach(card => {
                        card.classList.remove('unread');
                        const badge = card.querySelector('.badge-danger');
                        if (badge) {
                            badge.remove();
                        }
                        const markReadBtn = card.querySelector('button[onclick*="markAsRead"]');
                        if (markReadBtn) {
                            markReadBtn.remove();
                        }
                    });
                    showAlert('All notifications marked as read', 'success');
                }, 500);
            }
        }
        
        // Clear all notifications
        function clearAll() {
            if (confirm('Are you sure you want to delete all notifications? This action cannot be undone.')) {
                // Simulate API call
                setTimeout(() => {
                    const allCards = document.querySelectorAll('.notification-card');
                    allCards.forEach(card => {
                        card.remove();
                    });
                    showAlert('All notifications cleared', 'success');
                }, 500);
            }
        }
        
        // Show alert
        function showAlert(message, type) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            alertDiv.style.top = '20px';
            alertDiv.style.right = '20px';
            alertDiv.style.zIndex = '9999';
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(alertDiv);
            
            setTimeout(() => {
                alertDiv.remove();
            }, 3000);
        }
    </script>
}

