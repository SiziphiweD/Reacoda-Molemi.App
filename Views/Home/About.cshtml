@{
    ViewData["Title"] = "About Us";
}

<!-- Hero Section -->
<section class="hero-section-molemi">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-12 col-xl-12">
                <div class="hero-card-molemi">
                    <h1 class="hero-main-title">About Reacoda Molemi</h1>
                    <h2 class="hero-welcome-title">Connecting Farmers & Buyers</h2>
                    <h3 class="hero-description">Connecting farmers and buyers for a sustainable agricultural future in South Africa and beyond.</h3>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mission & Vision Section -->
<section class="mission-vision-section py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-12">
                <div class="section-badge">Mission & Vision</div>
            </div>
        </div>
        <div class="mission-vision-cards">
            <div class="mission-vision-card">
                <div class="mission-vision-icon-wrapper">
                    <div class="mission-vision-icon">
                        <i class="fas fa-bullseye"></i>
                    </div>
                </div>
                <h3 class="mission-vision-title">Our Mission</h3>
                <p class="mission-vision-text">To revolutionize agriculture in South Africa by creating a seamless digital marketplace that connects local farmers directly with consumers, promoting sustainable farming practices, reducing food waste, and supporting rural communities.</p>
            </div>
            <div class="mission-vision-card">
                <div class="mission-vision-icon-wrapper">
                    <div class="mission-vision-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                </div>
                <h3 class="mission-vision-title">Our Vision</h3>
                <p class="mission-vision-text">To become Africa's leading agritech platform, empowering farmers to reach wider markets while providing consumers with access to fresh, locally-sourced produce, fostering economic growth and food security across the continent.</p>
            </div>
        </div>
    </div>
</section>

<!-- Company Background -->
<section class="our-story-section py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="story-content">
                    <article class="story-item">
                        <div class="story-item-header">
                            <div class="story-icon-wrapper">
                                <div class="story-icon">
                                    <i class="fas fa-seedling"></i>
                                </div>
                            </div>
                            <h4 class="story-heading">Founded in 2024</h4>
                        </div>
                        <p class="story-text">Reacoda Molemi was born from a simple yet powerful idea: to bridge the gap between South Africa's hardworking farmers and the consumers who want fresh, quality produce. Our founders, passionate about sustainable agriculture and technology, recognized the challenges facing both farmers and buyers in the traditional supply chain.</p>
                    </article>
                    
                    <article class="story-item">
                        <div class="story-item-header">
                            <div class="story-icon-wrapper">
                                <div class="story-icon">
                                    <i class="fas fa-exclamation-triangle"></i>
                                </div>
                            </div>
                            <h4 class="story-heading">The Challenge</h4>
                        </div>
                        <p class="story-text">Farmers often struggle to reach consumers directly, while buyers have limited access to fresh, locally-grown produce. Middlemen take significant cuts, reducing farmers' profits and increasing costs for consumers. Food waste is rampant, and rural communities lack economic opportunities.</p>
                    </article>
                    
                    <article class="story-item">
                        <div class="story-item-header">
                            <div class="story-icon-wrapper">
                                <div class="story-icon">
                                    <i class="fas fa-lightbulb"></i>
                                </div>
                            </div>
                            <h4 class="story-heading">Our Solution</h4>
                        </div>
                        <p class="story-text">Reacoda Molemi leverages cutting-edge technology to create a direct connection between farmers and buyers. Our platform eliminates unnecessary intermediaries, ensures fair pricing, reduces food waste, and supports sustainable farming practices.</p>
                    </article>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Values Section -->
<section class="values-section py-5">
    <div class="container">
        <div class="values-content">
            <div class="value-item">
                <div class="feature-icon-wrapper">
                    <div class="feature-icon">
                        <i class="fas fa-leaf"></i>
                    </div>
                </div>
                <h5 class="feature-title">Sustainability</h5>
                <p class="feature-text">We promote environmentally friendly farming practices and support farmers who prioritize sustainable agriculture for future generations.</p>
            </div>
            <div class="value-item">
                <div class="feature-icon-wrapper">
                    <div class="feature-icon">
                        <i class="fas fa-handshake"></i>
                    </div>
                </div>
                <h5 class="feature-title">Fair Trade</h5>
                <p class="feature-text">We ensure fair pricing for farmers while providing consumers with transparent, competitive prices for quality produce.</p>
            </div>
            <div class="value-item">
                <div class="feature-icon-wrapper">
                    <div class="feature-icon">
                        <i class="fas fa-heart"></i>
                    </div>
                </div>
                <h5 class="feature-title">Community</h5>
                <p class="feature-text">We build strong communities by connecting local farmers with their neighbors, supporting rural development and food security.</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section-modern py-5">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="cta-card-modern text-center">
                    <h2 class="cta-title">Join the Reacoda Molemi Community</h2>
                    <p class="cta-subtitle">Be part of the agricultural revolution in South Africa</p>
                    <div class="d-flex flex-wrap justify-content-center gap-3 cta-buttons">
                        <a href="@Url.Action("Register", "Auth", new { role = "Farmer" })" class="btn btn-cta-primary btn-lg">
                            <i class="fas fa-user-plus me-2"></i>Join as Farmer
                        </a>
                        <a href="@Url.Action("Index", "Shop")" class="btn btn-cta-secondary btn-lg">
                            <i class="fas fa-shopping-cart me-2"></i>Shop Now
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

