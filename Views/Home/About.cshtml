@{
    ViewData["Title"] = "About Us";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="hero-title fade-in">About Reacoda Molemi</h1>
                <p class="hero-subtitle fade-in">Connecting farmers and buyers for a sustainable agricultural future in South Africa and beyond.</p>
            </div>
            <div class="col-lg-4">
                <div class="text-center">
                    <i class="fas fa-seedling" style="font-size: 8rem; opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mission & Vision Section -->
<section class="py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <i class="fas fa-bullseye text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h3 class="fw-bold text-center mb-4">Our Mission</h3>
                        <p class="text-muted text-center">To revolutionize agriculture in South Africa by creating a seamless digital marketplace that connects local farmers directly with consumers, promoting sustainable farming practices, reducing food waste, and supporting rural communities.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <i class="fas fa-eye text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h3 class="fw-bold text-center mb-4">Our Vision</h3>
                        <p class="text-muted text-center">To become Africa's leading agritech platform, empowering farmers to reach wider markets while providing consumers with access to fresh, locally-sourced produce, fostering economic growth and food security across the continent.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Company Background -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="fw-bold text-center mb-5">Our Story</h2>
            </div>
        </div>
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h4 class="fw-bold mb-3">Founded in 2024</h4>
                <p class="text-muted mb-4">Reacoda Molemi was born from a simple yet powerful idea: to bridge the gap between South Africa's hardworking farmers and the consumers who want fresh, quality produce. Our founders, passionate about sustainable agriculture and technology, recognized the challenges facing both farmers and buyers in the traditional supply chain.</p>
                
                <h4 class="fw-bold mb-3">The Challenge</h4>
                <p class="text-muted mb-4">Farmers often struggle to reach consumers directly, while buyers have limited access to fresh, locally-grown produce. Middlemen take significant cuts, reducing farmers' profits and increasing costs for consumers. Food waste is rampant, and rural communities lack economic opportunities.</p>
                
                <h4 class="fw-bold mb-3">Our Solution</h4>
                <p class="text-muted">Reacoda Molemi leverages cutting-edge technology to create a direct connection between farmers and buyers. Our platform eliminates unnecessary intermediaries, ensures fair pricing, reduces food waste, and supports sustainable farming practices.</p>
            </div>
            <div class="col-lg-6">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="card text-center p-4">
                            <div class="card-body">
                                <i class="fas fa-users text-success mb-3" style="font-size: 2.5rem;"></i>
                                <h5 class="fw-bold">500+</h5>
                                <p class="text-muted small">Active Farmers</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card text-center p-4">
                            <div class="card-body">
                                <i class="fas fa-shopping-cart text-success mb-3" style="font-size: 2.5rem;"></i>
                                <h5 class="fw-bold">2,000+</h5>
                                <p class="text-muted small">Happy Customers</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card text-center p-4">
                            <div class="card-body">
                                <i class="fas fa-box text-success mb-3" style="font-size: 2.5rem;"></i>
                                <h5 class="fw-bold">10,000+</h5>
                                <p class="text-muted small">Products Listed</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card text-center p-4">
                            <div class="card-body">
                                <i class="fas fa-map-marker-alt text-success mb-3" style="font-size: 2.5rem;"></i>
                                <h5 class="fw-bold">25+</h5>
                                <p class="text-muted small">Cities Covered</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Values Section -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="fw-bold text-center mb-5">Our Values</h2>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 text-center p-4">
                    <div class="card-body">
                        <div class="mb-3">
                            <i class="fas fa-leaf text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title fw-bold">Sustainability</h5>
                        <p class="card-text text-muted">We promote environmentally friendly farming practices and support farmers who prioritize sustainable agriculture for future generations.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 text-center p-4">
                    <div class="card-body">
                        <div class="mb-3">
                            <i class="fas fa-handshake text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title fw-bold">Fair Trade</h5>
                        <p class="card-text text-muted">We ensure fair pricing for farmers while providing consumers with transparent, competitive prices for quality produce.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 text-center p-4">
                    <div class="card-body">
                        <div class="mb-3">
                            <i class="fas fa-heart text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title fw-bold">Community</h5>
                        <p class="card-text text-muted">We build strong communities by connecting local farmers with their neighbors, supporting rural development and food security.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="fw-bold text-center mb-5">Our Team</h2>
                <p class="text-muted text-center mb-5">Meet the passionate individuals behind Reacoda Molemi, working to transform agriculture in South Africa.</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                                <i class="fas fa-user" style="font-size: 2rem;"></i>
                            </div>
                        </div>
                        <h5 class="fw-bold">Sizip Mthembu</h5>
                        <p class="text-success fw-bold">Founder & CEO</p>
                        <p class="text-muted small">Agricultural technology expert with 10+ years experience in sustainable farming and rural development.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                                <i class="fas fa-user" style="font-size: 2rem;"></i>
                            </div>
                        </div>
                        <h5 class="fw-bold">Thabo Molemi</h5>
                        <p class="text-success fw-bold">CTO</p>
                        <p class="text-muted small">Technology innovator specializing in scalable platforms and mobile solutions for emerging markets.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                                <i class="fas fa-user" style="font-size: 2rem;"></i>
                            </div>
                        </div>
                        <h5 class="fw-bold">Nomsa Dlamini</h5>
                        <p class="text-success fw-bold">Head of Operations</p>
                        <p class="text-muted small">Operations specialist focused on farmer relations and supply chain optimization across South Africa.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="fw-bold mb-3">Join the Reacoda Molemi Community</h2>
                <p class="text-muted mb-4">Be part of the agricultural revolution in South Africa</p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-success btn-lg">
                        <i class="fas fa-user-plus me-2"></i>Join as Farmer
                    </a>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-success btn-lg">
                        <i class="fas fa-shopping-cart me-2"></i>Join as Buyer
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

