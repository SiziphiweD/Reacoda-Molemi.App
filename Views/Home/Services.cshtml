@{
    ViewData["Title"] = "Our Services";
}

<!-- Hero Section -->
<section class="hero-section-molemi">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-12 col-xl-12">
                <div class="hero-card-molemi">
                    <h1 class="hero-main-title">Our Services</h1>
                    <h2 class="hero-welcome-title">Comprehensive Solutions</h2>
                    <h3 class="hero-description">Comprehensive solutions for farmers, buyers, and agricultural communities across South Africa.</h3>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Farmer Services -->
<section class="services-section py-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-12 text-center">
                <div class="service-section-header">
                    <div class="service-section-icon">
                        <i class="fas fa-tractor"></i>
                    </div>
                    <h2 class="service-section-title">Services for Farmers</h2>
                    <p class="service-section-subtitle">Empower your farming business with our comprehensive tools and services</p>
                </div>
            </div>
        </div>
        <div class="services-cards-container">
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-store"></i>
                </div>
                <h5 class="service-card-title">Digital Marketplace</h5>
                <p class="service-card-text">List and sell your produce directly to consumers without middlemen. Set your own prices and reach customers across South Africa.</p>
            </div>
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h5 class="service-card-title">Analytics Dashboard</h5>
                <p class="service-card-text">Track your sales performance, monitor inventory levels, and analyze customer preferences to optimize your farming operations.</p>
            </div>
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-mobile-alt"></i>
                </div>
                <h5 class="service-card-title">Mobile Management</h5>
                <p class="service-card-text">Manage your listings, process orders, and communicate with customers using our mobile-friendly platform.</p>
            </div>
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h5 class="service-card-title">Quality Assurance</h5>
                <p class="service-card-text">Our verification process ensures your products meet quality standards, building trust with customers and increasing sales.</p>
            </div>
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-money-bill-wave"></i>
                </div>
                <h5 class="service-card-title">Secure Payments</h5>
                <p class="service-card-text">Receive payments securely through multiple channels including bank transfers, mobile money, and cash on delivery.</p>
            </div>
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-graduation-cap"></i>
                </div>
                <h5 class="service-card-title">Training & Support</h5>
                <p class="service-card-text">Access educational resources, farming best practices, and technical support to improve your agricultural productivity.</p>
            </div>
        </div>
    </div>
</section>

<!-- Buyer Services -->
<section class="services-section py-5 bg-light">
    <div class="container">
        <div class="row mb-5">
            <div class="col-12 text-center">
                <div class="service-section-header">
                    <div class="service-section-icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <h2 class="service-section-title">Services for Buyers</h2>
                    <p class="service-section-subtitle">Discover fresh produce and shop with confidence</p>
                </div>
            </div>
        </div>
        <div class="services-cards-container">
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-search"></i>
                </div>
                <h5 class="service-card-title">Product Discovery</h5>
                <p class="service-card-text">Browse thousands of fresh products from local farmers. Use filters to find exactly what you need by category, location, and price.</p>
            </div>
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-truck"></i>
                </div>
                <h5 class="service-card-title">Fast Delivery</h5>
                <p class="service-card-text">Get fresh produce delivered to your doorstep quickly and safely. Track your orders in real-time from farm to table.</p>
            </div>
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-star"></i>
                </div>
                <h5 class="service-card-title">Quality Guarantee</h5>
                <p class="service-card-text">All products are verified for quality and freshness. Read reviews from other customers and rate your purchases.</p>
            </div>
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-heart"></i>
                </div>
                <h5 class="service-card-title">Support Local</h5>
                <p class="service-card-text">Support local farmers and communities while getting the freshest, highest quality produce available.</p>
            </div>
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-credit-card"></i>
                </div>
                <h5 class="service-card-title">Flexible Payment</h5>
                <p class="service-card-text">Pay securely using your preferred method - credit card, bank transfer, mobile money, or cash on delivery.</p>
            </div>
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-history"></i>
                </div>
                <h5 class="service-card-title">Order History</h5>
                <p class="service-card-text">Keep track of all your purchases, reorder favorite products, and manage your shopping preferences.</p>
            </div>
        </div>
    </div>
</section>

<!-- Additional Services -->
<section class="services-section py-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-12 text-center">
                <div class="service-section-header">
                    <div class="service-section-icon">
                        <i class="fas fa-plus-circle"></i>
                    </div>
                    <h2 class="service-section-title">Additional Services</h2>
                    <p class="service-section-subtitle">Enhanced features to improve your experience</p>
                </div>
            </div>
        </div>
        <div class="services-cards-container">
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-mobile-alt"></i>
                </div>
                <h5 class="service-card-title">Mobile App</h5>
                <p class="service-card-text">Access Reacoda Molemi on the go with our mobile applications for iOS and Android devices.</p>
            </div>
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-bell"></i>
                </div>
                <h5 class="service-card-title">Real-time Notifications</h5>
                <p class="service-card-text">Stay updated with instant notifications about orders, messages, and important platform updates.</p>
            </div>
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-comments"></i>
                </div>
                <h5 class="service-card-title">Communication Tools</h5>
                <p class="service-card-text">Built-in messaging system for direct communication between farmers and buyers.</p>
            </div>
            <div class="service-card-small">
                <div class="service-card-icon">
                    <i class="fas fa-globe"></i>
                </div>
                <h5 class="service-card-title">Multi-language Support</h5>
                <p class="service-card-text">Platform available in English, Afrikaans, Zulu, and other South African languages.</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section-modern py-5">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="cta-card-modern text-center">
                    <h2 class="cta-title">Join the Reacoda Molemi Community</h2>
                    <p class="cta-subtitle">Be part of the agricultural revolution in South Africa</p>
                    <div class="d-flex flex-wrap justify-content-center gap-3 cta-buttons">
                        <a href="@Url.Action("Register", "Auth", new { role = "Farmer" })" class="btn btn-cta-primary btn-lg">
                            <i class="fas fa-user-plus me-2"></i>Join as Farmer
                        </a>
                        <a href="@Url.Action("Index", "Shop")" class="btn btn-cta-secondary btn-lg">
                            <i class="fas fa-shopping-cart me-2"></i>Shop Now
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

