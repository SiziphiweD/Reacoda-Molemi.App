@{
    ViewData["Title"] = "Our Services";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="hero-title fade-in">Our Services</h1>
                <p class="hero-subtitle fade-in">Comprehensive solutions for farmers, buyers, and agricultural communities across South Africa.</p>
            </div>
            <div class="col-lg-4">
                <div class="text-center">
                    <i class="fas fa-cogs" style="font-size: 8rem; opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Services Overview -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="fw-bold text-center mb-5">Platform Services</h2>
                <p class="text-muted text-center mb-5">Reacoda Molemi provides a comprehensive suite of services designed to support every aspect of the agricultural supply chain.</p>
            </div>
        </div>
    </div>
</section>

<!-- Farmer Services -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="fw-bold text-center mb-5">
                    <i class="fas fa-tractor text-success me-3"></i>Services for Farmers
                </h2>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-store text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Digital Marketplace</h5>
                        <p class="text-muted text-center">List and sell your produce directly to consumers without middlemen. Set your own prices and reach customers across South Africa.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-chart-line text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Analytics Dashboard</h5>
                        <p class="text-muted text-center">Track your sales performance, monitor inventory levels, and analyze customer preferences to optimize your farming operations.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-mobile-alt text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Mobile Management</h5>
                        <p class="text-muted text-center">Manage your listings, process orders, and communicate with customers using our mobile-friendly platform.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-shield-alt text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Quality Assurance</h5>
                        <p class="text-muted text-center">Our verification process ensures your products meet quality standards, building trust with customers and increasing sales.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-money-bill-wave text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Secure Payments</h5>
                        <p class="text-muted text-center">Receive payments securely through multiple channels including bank transfers, mobile money, and cash on delivery.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-graduation-cap text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Training & Support</h5>
                        <p class="text-muted text-center">Access educational resources, farming best practices, and technical support to improve your agricultural productivity.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Buyer Services -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="fw-bold text-center mb-5">
                    <i class="fas fa-shopping-cart text-success me-3"></i>Services for Buyers
                </h2>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-search text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Product Discovery</h5>
                        <p class="text-muted text-center">Browse thousands of fresh products from local farmers. Use filters to find exactly what you need by category, location, and price.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-truck text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Fast Delivery</h5>
                        <p class="text-muted text-center">Get fresh produce delivered to your doorstep quickly and safely. Track your orders in real-time from farm to table.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-star text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Quality Guarantee</h5>
                        <p class="text-muted text-center">All products are verified for quality and freshness. Read reviews from other customers and rate your purchases.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-heart text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Support Local</h5>
                        <p class="text-muted text-center">Support local farmers and communities while getting the freshest, highest quality produce available.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-credit-card text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Flexible Payment</h5>
                        <p class="text-muted text-center">Pay securely using your preferred method - credit card, bank transfer, mobile money, or cash on delivery.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-history text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Order History</h5>
                        <p class="text-muted text-center">Keep track of all your purchases, reorder favorite products, and manage your shopping preferences.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Admin Services -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="fw-bold text-center mb-5">
                    <i class="fas fa-user-cog text-success me-3"></i>Services for Administrators
                </h2>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-users text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">User Management</h5>
                        <p class="text-muted text-center">Manage farmer and buyer accounts, verify credentials, and ensure platform integrity and security.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-check-circle text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Product Verification</h5>
                        <p class="text-muted text-center">Review and approve product listings to maintain quality standards and protect consumer interests.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-chart-bar text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Analytics & Reports</h5>
                        <p class="text-muted text-center">Access comprehensive analytics on platform usage, sales trends, and user behavior to make data-driven decisions.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-headset text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Customer Support</h5>
                        <p class="text-muted text-center">Provide support to users, resolve disputes, and maintain high levels of customer satisfaction.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-cog text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Platform Configuration</h5>
                        <p class="text-muted text-center">Configure platform settings, manage categories, set commission rates, and customize the user experience.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="text-center mb-3">
                            <i class="fas fa-shield-alt text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold text-center mb-3">Security & Compliance</h5>
                        <p class="text-muted text-center">Monitor platform security, ensure compliance with regulations, and protect user data and transactions.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Additional Services -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="fw-bold text-center mb-5">Additional Services</h2>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-start">
                            <div class="me-3">
                                <i class="fas fa-mobile-alt text-success" style="font-size: 2.5rem;"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold">Mobile App</h5>
                                <p class="text-muted">Access Reacoda Molemi on the go with our mobile applications for iOS and Android devices.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-start">
                            <div class="me-3">
                                <i class="fas fa-bell text-success" style="font-size: 2.5rem;"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold">Real-time Notifications</h5>
                                <p class="text-muted">Stay updated with instant notifications about orders, messages, and important platform updates.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-start">
                            <div class="me-3">
                                <i class="fas fa-comments text-success" style="font-size: 2.5rem;"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold">Communication Tools</h5>
                                <p class="text-muted">Built-in messaging system for direct communication between farmers and buyers.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-start">
                            <div class="me-3">
                                <i class="fas fa-globe text-success" style="font-size: 2.5rem;"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold">Multi-language Support</h5>
                                <p class="text-muted">Platform available in English, Afrikaans, Zulu, and other South African languages.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="fw-bold mb-3">Ready to Get Started?</h2>
                <p class="text-muted mb-4">Join thousands of farmers and buyers already using Reacoda Molemi</p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-success btn-lg">
                        <i class="fas fa-user-plus me-2"></i>Sign Up Now
                    </a>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-success btn-lg">
                        <i class="fas fa-envelope me-2"></i>Contact Us
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

