@{
    ViewData["Title"] = "Contact Us";
}

<!-- Hero Section -->
<section class="hero-section-molemi">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-12 col-xl-12">
                <div class="hero-card-molemi">
                    <h1 class="hero-main-title">Contact Us</h1>
                    <h2 class="hero-welcome-title">Get in Touch</h2>
                    <h3 class="hero-description">Get in touch with the Reacoda Molemi team. We're here to help farmers, buyers, and agricultural communities across South Africa.</h3>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Information -->
<section class="contact-section py-5">
    <div class="container">
        <div class="row g-4">
            <!-- Contact Form -->
            <div class="col-lg-8">
                <div class="contact-form-card">
                    <div class="contact-form-header">
                        <div class="contact-form-icon">
                            <i class="fas fa-paper-plane"></i>
                        </div>
                        <h2 class="contact-form-title">Send us a Message</h2>
                        <p class="contact-form-subtitle">Fill out the form below and we'll get back to you as soon as possible</p>
                    </div>
                    <div class="contact-form-body">
                        <form id="contactForm" class="contact-form-modern">
                            <div class="form-row-modern">
                                <div class="form-group-modern">
                                    <label for="firstName" class="form-label-modern">First Name</label>
                                    <input type="text" class="form-input-modern" id="firstName" required>
                                </div>
                                <div class="form-group-modern">
                                    <label for="lastName" class="form-label-modern">Last Name</label>
                                    <input type="text" class="form-input-modern" id="lastName" required>
                                </div>
                            </div>
                            
                            <div class="form-row-modern">
                                <div class="form-group-modern">
                                    <label for="email" class="form-label-modern">Email Address</label>
                                    <input type="email" class="form-input-modern" id="email" required>
                                </div>
                                <div class="form-group-modern">
                                    <label for="phone" class="form-label-modern">Phone Number</label>
                                    <input type="tel" class="form-input-modern" id="phone">
                                </div>
                            </div>
                            
                            <div class="form-group-modern">
                                <label for="subject" class="form-label-modern">Subject</label>
                                <select class="form-select-modern" id="subject" required>
                                    <option value="">Select a subject</option>
                                    <option value="general">General Inquiry</option>
                                    <option value="farmer">Farmer Support</option>
                                    <option value="buyer">Buyer Support</option>
                                    <option value="technical">Technical Support</option>
                                    <option value="partnership">Partnership</option>
                                    <option value="media">Media Inquiry</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                            
                            <div class="form-group-modern">
                                <label for="message" class="form-label-modern">Message</label>
                                <textarea class="form-textarea-modern" id="message" rows="5" placeholder="Tell us how we can help you..." required></textarea>
                            </div>
                            
                            <div class="form-actions-modern">
                                <button type="submit" class="btn-contact-submit">
                                    <i class="fas fa-paper-plane"></i>
                                    <span>Send Message</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            
            <!-- Contact Information -->
            <div class="col-lg-4">
                <div class="contact-info-card">
                    <div class="contact-info-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <h3 class="contact-info-title">Office Address</h3>
                    <div class="contact-info-content">
                        <p class="contact-info-text">
                            <strong>Reacoda Molemi Headquarters</strong><br>
                            Tshimologong Precinct<br>
                            Braamfontein, Johannesburg<br>
                            City of Johannesburg Metropolitan Municipality<br>
                            South Africa<br>
                            <a href="https://tshimologong.joburg" target="_blank" class="contact-info-link">tshimologong.joburg</a>
                        </p>
                    </div>
                </div>
                
                <div class="contact-info-card">
                    <div class="contact-info-icon">
                        <i class="fas fa-phone"></i>
                    </div>
                    <h3 class="contact-info-title">Contact Details</h3>
                    <div class="contact-info-content">
                        <div class="contact-info-item">
                            <strong>Phone:</strong>
                            <a href="tel:+27111234567" class="contact-info-link">+27 11 123 4567</a>
                        </div>
                        <div class="contact-info-item">
                            <strong>Email:</strong>
                            <a href="mailto:info@reacoda.com" class="contact-info-link">info@reacoda.com</a>
                        </div>
                        <div class="contact-info-item">
                            <strong>Support:</strong>
                            <a href="mailto:support@reacoda.com" class="contact-info-link">support@reacoda.com</a>
                        </div>
                        <div class="contact-info-item">
                            <strong>Business Hours:</strong>
                            <div class="contact-hours">
                                Monday - Friday: 8:00 AM - 6:00 PM<br>
                                Saturday: 9:00 AM - 2:00 PM<br>
                                Sunday: Closed
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="contact-info-card">
                    <div class="contact-info-icon">
                        <i class="fas fa-share-alt"></i>
                    </div>
                    <h3 class="contact-info-title">Follow Us</h3>
                    <div class="contact-info-content">
                        <div class="social-links-modern">
                            <a href="#" class="social-link-modern" title="Facebook">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                            <a href="#" class="social-link-modern" title="Twitter">
                                <i class="fab fa-twitter"></i>
                            </a>
                            <a href="#" class="social-link-modern" title="Instagram">
                                <i class="fab fa-instagram"></i>
                            </a>
                            <a href="#" class="social-link-modern" title="LinkedIn">
                                <i class="fab fa-linkedin-in"></i>
                            </a>
                            <a href="#" class="social-link-modern" title="YouTube">
                                <i class="fab fa-youtube"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FAQ Section -->
<section class="faq-section py-5 bg-light">
    <div class="container">
        <div class="row mb-5">
            <div class="col-12 text-center">
                <div class="faq-section-header">
                    <div class="faq-section-icon">
                        <i class="fas fa-question-circle"></i>
                    </div>
                    <h2 class="faq-section-title">Frequently Asked Questions</h2>
                    <p class="faq-section-subtitle">Find answers to common questions about Reacoda Molemi</p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="faq-accordion-modern" id="faqAccordion">
                    <div class="faq-item-modern">
                        <h3 class="faq-question-modern">
                            <button class="faq-button-modern" type="button" data-bs-toggle="collapse" data-bs-target="#faq1" aria-expanded="true">
                                <span>How do I register as a farmer on Reacoda Molemi?</span>
                                <i class="fas fa-chevron-down"></i>
                            </button>
                        </h3>
                        <div id="faq1" class="faq-answer-modern collapse show" data-bs-parent="#faqAccordion">
                            <div class="faq-answer-content">
                                Simply click "Sign Up" and select "I want to sell products as a farmer". You'll need to provide basic information about your farm and undergo a verification process to ensure quality standards.
                            </div>
                        </div>
                    </div>
                    
                    <div class="faq-item-modern">
                        <h3 class="faq-question-modern">
                            <button class="faq-button-modern collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                <span>What are the fees for using the platform?</span>
                                <i class="fas fa-chevron-down"></i>
                            </button>
                        </h3>
                        <div id="faq2" class="faq-answer-modern collapse" data-bs-parent="#faqAccordion">
                            <div class="faq-answer-content">
                                Reacoda Molemi charges a small commission on successful sales to cover platform maintenance and support. There are no upfront fees for farmers or buyers to join the platform.
                            </div>
                        </div>
                    </div>
                    
                    <div class="faq-item-modern">
                        <h3 class="faq-question-modern">
                            <button class="faq-button-modern collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                <span>How does delivery work?</span>
                                <i class="fas fa-chevron-down"></i>
                            </button>
                        </h3>
                        <div id="faq3" class="faq-answer-modern collapse" data-bs-parent="#faqAccordion">
                            <div class="faq-answer-content">
                                Delivery is handled by our network of trusted logistics partners. Farmers can also arrange their own delivery. Delivery fees vary by location and are clearly displayed during checkout.
                            </div>
                        </div>
                    </div>
                    
                    <div class="faq-item-modern">
                        <h3 class="faq-question-modern">
                            <button class="faq-button-modern collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                                <span>What if I'm not satisfied with my order?</span>
                                <i class="fas fa-chevron-down"></i>
                            </button>
                        </h3>
                        <div id="faq4" class="faq-answer-modern collapse" data-bs-parent="#faqAccordion">
                            <div class="faq-answer-content">
                                We offer a satisfaction guarantee. If you're not happy with your order, contact our support team within 24 hours of delivery, and we'll work to resolve the issue.
                            </div>
                        </div>
                    </div>
                    
                    <div class="faq-item-modern">
                        <h3 class="faq-question-modern">
                            <button class="faq-button-modern collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                                <span>Is my personal information secure?</span>
                                <i class="fas fa-chevron-down"></i>
                            </button>
                        </h3>
                        <div id="faq5" class="faq-answer-modern collapse" data-bs-parent="#faqAccordion">
                            <div class="faq-answer-content">
                                Yes, we take data security seriously. All personal information is encrypted and stored securely. We comply with South African data protection regulations and never share your information with third parties without consent.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Support Section -->
