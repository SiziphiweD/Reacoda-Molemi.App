@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 hero-content">
                <h1 class="hero-title fade-in-up">Welcome to Reacoda Molemi</h1>
                <p class="hero-subtitle fade-in-up">South Africa's premier agritech marketplace connecting farmers and buyers for fresh, sustainable produce. Supporting local communities and sustainable agriculture.</p>
                <div class="d-flex gap-3 fade-in-up">
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-light btn-lg">
                        <i class="fas fa-store me-2"></i>Start Shopping
                    </a>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-light btn-lg">
                        <i class="fas fa-seedling me-2"></i>Become a Farmer
                    </a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="text-center">
                    <i class="fas fa-seedling" style="font-size: 8rem; opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-12">
                <h2 class="fw-bold mb-3">Why Choose Reacoda Molemi?</h2>
                <p class="text-muted">Connecting farmers and buyers for a sustainable future</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 text-center p-4">
                    <div class="card-body">
                        <div class="mb-3">
                            <i class="fas fa-leaf text-primary-green" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title fw-bold">Fresh & Organic</h5>
                        <p class="card-text text-muted">Get the freshest produce directly from local farms, ensuring maximum nutrition and taste.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 text-center p-4">
                    <div class="card-body">
                        <div class="mb-3">
                            <i class="fas fa-truck text-primary-green" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title fw-bold">Fast Delivery</h5>
                        <p class="card-text text-muted">Quick and reliable delivery to your doorstep, maintaining freshness throughout the journey.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 text-center p-4">
                    <div class="card-body">
                        <div class="mb-3">
                            <i class="fas fa-heart text-primary-green" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="card-title fw-bold">Support Local</h5>
                        <p class="card-text text-muted">Support local farmers and communities while getting the best quality produce.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section class="py-5 bg-accent-cream">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-12">
                <h2 class="fw-bold mb-3">How It Works</h2>
                <p class="text-muted">Simple steps to get started</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <div class="mb-3">
                    <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <span class="fw-bold fs-4">1</span>
                    </div>
                </div>
                <h5 class="fw-bold">Browse Products</h5>
                <p class="text-muted">Explore fresh produce from local farmers in your area.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="mb-3">
                    <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <span class="fw-bold fs-4">2</span>
                    </div>
                </div>
                <h5 class="fw-bold">Add to Cart</h5>
                <p class="text-muted">Select your favorite items and add them to your cart.</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="mb-3">
                    <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <span class="fw-bold fs-4">3</span>
                    </div>
                </div>
                <h5 class="fw-bold">Get Delivered</h5>
                <p class="text-muted">Receive fresh produce delivered to your doorstep.</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="fw-bold mb-3">Ready to Get Started?</h2>
                <p class="text-muted mb-4">Join thousands of satisfied customers and farmers</p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-primary btn-lg">
                        <i class="fas fa-user-plus me-2"></i>Sign Up Now
                    </a>
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-primary btn-lg">
                        <i class="fas fa-store me-2"></i>Browse Products
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
