@model SystemConfigurationViewModel
@{
    ViewData["Title"] = "System Configuration";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0 text-success">
                    <i class="fas fa-cogs me-2"></i>System Configuration
                </h1>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-8 col-lg-7">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Platform Settings</h6>
                </div>
                <div class="card-body">
                    <form id="systemConfigForm">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="platformName" class="form-label">Platform Name</label>
                                    <input type="text" class="form-control" id="platformName" value="@Model.PlatformName">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="supportEmail" class="form-label">Support Email</label>
                                    <input type="email" class="form-control" id="supportEmail" value="@Model.SupportEmail">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="commissionRate" class="form-label">Platform Commission Rate (%)</label>
                                    <input type="number" class="form-control" id="commissionRate" value="@Model.PlatformCommissionRate" step="0.1" min="0" max="100">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="orderTimeout" class="form-label">Order Timeout (Hours)</label>
                                    <input type="number" class="form-control" id="orderTimeout" value="@Model.OrderTimeoutHours" min="1" max="168">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="maxImages" class="form-label">Max Product Images</label>
                                    <input type="number" class="form-control" id="maxImages" value="@Model.MaxProductImages" min="1" max="10">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="paymentGateway" @(Model.PaymentGatewayEnabled ? "checked" : "")>
                                    <label class="form-check-label" for="paymentGateway">
                                        Enable Payment Gateway
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="emailNotifications" @(Model.EmailNotificationsEnabled ? "checked" : "")>
                                    <label class="form-check-label" for="emailNotifications">
                                        Enable Email Notifications
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i>Save Configuration
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-5">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">System Status</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <span>Database Status</span>
                                <span class="badge badge-success">Online</span>
                            </div>
                        </div>
                        <div class="col-12 mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <span>Email Service</span>
                                <span class="badge badge-success">Active</span>
                            </div>
                        </div>
                        <div class="col-12 mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <span>Payment Gateway</span>
                                <span class="badge badge-@(Model.PaymentGatewayEnabled ? "success" : "warning")">
                                    @(Model.PaymentGatewayEnabled ? "Enabled" : "Disabled")
                                </span>
                            </div>
                        </div>
                        <div class="col-12 mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <span>Notifications</span>
                                <span class="badge badge-@(Model.EmailNotificationsEnabled ? "success" : "warning")">
                                    @(Model.EmailNotificationsEnabled ? "Enabled" : "Disabled")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-outline-primary" onclick="clearCache()">
                            <i class="fas fa-trash-alt me-1"></i>Clear Cache
                        </button>
                        <button type="button" class="btn btn-outline-warning" onclick="backupDatabase()">
                            <i class="fas fa-database me-1"></i>Backup Database
                        </button>
                        <button type="button" class="btn btn-outline-info" onclick="sendTestEmail()">
                            <i class="fas fa-envelope me-1"></i>Send Test Email
                        </button>
                        <button type="button" class="btn btn-outline-danger" onclick="restartServices()">
                            <i class="fas fa-redo me-1"></i>Restart Services
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('systemConfigForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData();
            formData.append('PlatformName', document.getElementById('platformName').value);
            formData.append('SupportEmail', document.getElementById('supportEmail').value);
            formData.append('PlatformCommissionRate', document.getElementById('commissionRate').value);
            formData.append('OrderTimeoutHours', document.getElementById('orderTimeout').value);
            formData.append('MaxProductImages', document.getElementById('maxImages').value);
            formData.append('PaymentGatewayEnabled', document.getElementById('paymentGateway').checked);
            formData.append('EmailNotificationsEnabled', document.getElementById('emailNotifications').checked);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            try {
                const response = await fetch('@Url.Action("UpdateSystemConfiguration", "SuperAdmin")', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                
                if (result.success) {
                    showToast('System configuration updated successfully!', 'success');
                } else {
                    showToast(result.message, 'error');
                }
            } catch (error) {
                showToast('Error updating configuration.', 'error');
            }
        });

        function clearCache() {
            if (confirm('Are you sure you want to clear the system cache?')) {
                showToast('Cache cleared successfully!', 'success');
            }
        }

        function backupDatabase() {
            if (confirm('Are you sure you want to create a database backup?')) {
                showToast('Database backup initiated!', 'success');
            }
        }

        function sendTestEmail() {
            showToast('Test email sent successfully!', 'success');
        }

        function restartServices() {
            if (confirm('Are you sure you want to restart all services? This may cause temporary downtime.')) {
                showToast('Services restart initiated!', 'success');
            }
        }
    </script>
}












